{% extends 'base.html.twig' %}

{% block title %}Tableau de Bord - Jeffarma{% endblock %}

{% block body %}
<!-- En-tête -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-speedometer2 text-primary me-2"></i> Tableau de Bord
        </h1>
        <p class="page-subtitle mb-0">Vue d'ensemble de l'activité de votre pharmacie</p>
    </div>
    <div>
        <div class="bg-white px-4 py-2 rounded-pill shadow-sm border text-primary fw-medium">
            <i class="bi bi-calendar3 me-2"></i> Aujourd'hui : {{ "now"|date("d/m/Y") }}
        </div>
    </div>
</div>

<!-- Bannière d'Action Rapide -->
<div class="card shadow-sm border-0 mb-4 bg-primary text-white" style="background: linear-gradient(135deg, var(--color-primary) 0%, #059669 100%);">
    <div class="card-body p-4 p-md-5">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="fw-bold mb-2">Bonjour {{ app.user ? app.user.userIdentifier : 'Docteur' }},</h2>
                <p class="fs-5 opacity-75 mb-4 mb-md-0">Prêt pour une nouvelle journée ? Accédez rapidement à la caisse ou consultez vos alertes de stock.</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a class="btn btn-light btn-lg text-primary fw-bold shadow-sm mb-2 mb-md-0 me-2" href="{{ path('app_vente_new') }}">
                    <i class="bi bi-cart-plus me-2"></i> Caisse
                </a>
                <a class="btn btn-outline-light btn-lg fw-bold" href="{{ path('app_stock_reapprovisionnement') }}">
                    <i class="bi bi-box-seam me-2"></i> Stocks
                </a>
            </div>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <!-- CA du jour -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-currency-euro fs-4"></i>
                    </div>
                </div>
                <h6 class="text-muted text-uppercase fw-bold mb-1">Ventes du jour</h6>
                <div class="h3 fw-bold text-dark mb-0">{{ chiffreAffairesJour|number_format(2, ',', ' ') }} €</div>
            </div>
        </div>
    </div>

    <!-- Patients -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
                <h6 class="text-muted text-uppercase fw-bold mb-1">Patients Actifs</h6>
                <div class="h3 fw-bold text-dark mb-0">{{ nbPatients }}</div>
            </div>
        </div>
    </div>

    <!-- Ordonnances récentes -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                        <i class="bi bi-file-medical fs-4"></i>
                    </div>
                </div>
                <h6 class="text-muted text-uppercase fw-bold mb-1">Ordonnances (7J)</h6>
                <div class="h3 fw-bold text-dark mb-0">{{ nbOrdonnancesRecentes }}</div>
            </div>
        </div>
    </div>

    <!-- Alertes Stock -->
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 position-relative overflow-hidden">
            {% if nbStockCritique > 0 %}
                <div class="position-absolute top-0 start-0 w-100 h-100 bg-danger opacity-10"></div>
            {% endif %}
            <div class="card-body p-4 position-relative z-1">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="{% if nbStockCritique > 0 %}bg-danger text-white{% else %}bg-secondary bg-opacity-10 text-secondary{% endif %} rounded-3 p-3">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
                <h6 class="{% if nbStockCritique > 0 %}text-danger{% else %}text-muted{% endif %} text-uppercase fw-bold mb-1">Stock Critique</h6>
                <div class="h3 fw-bold {% if nbStockCritique > 0 %}text-danger{% else %}text-dark{% endif %} mb-0">{{ nbStockCritique }}</div>
                {% if nbStockCritique > 0 %}
                    <a href="{{ path('app_stock_reapprovisionnement') }}" class="stretched-link"></a>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Section Graphique et Raccourcis -->
<div class="row g-4">
    <!-- Graphique des ventes -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-graph-up-arrow text-primary me-2"></i> Évolution des Ventes (7 derniers jours)
                </h5>
            </div>
            <div class="card-body p-4">
                <canvas id="salesChart"
                        height="100"
                        data-controller="sales-chart"
                        data-sales-chart-labels-value="{{ ventesChartLabels|raw }}"
                        data-sales-chart-data-value="{{ ventesChartData|raw }}">
                </canvas>
            </div>
        </div>
    </div>

    <!-- Raccourcis utiles -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-lightning text-warning me-2"></i> Accès Rapides
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <a href="{{ path('app_patient_new') }}" class="list-group-item list-group-item-action p-4 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3">
                            <i class="bi bi-person-plus fs-5"></i>
                        </div>
                        <div class="fw-medium">Nouveau Patient</div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </a>
                    <a href="{{ path('app_ordonnance_new') }}" class="list-group-item list-group-item-action p-4 d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 me-3">
                            <i class="bi bi-file-earmark-plus fs-5"></i>
                        </div>
                        <div class="fw-medium">Saisir une Ordonnance</div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </a>
                    <a href="{{ path('app_produit_index') }}" class="list-group-item list-group-item-action p-4 d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 me-3">
                            <i class="bi bi-box fs-5"></i>
                        </div>
                        <div class="fw-medium">Catalogue Produits</div>
                        <i class="bi bi-chevron-right ms-auto text-muted"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}