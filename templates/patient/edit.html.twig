{% extends 'base.html.twig' %}

{% block title %}Modifier {{ patient.prenomPatient }} {{ patient.nomPatient }} - Jeffarma{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-pencil-square text-warning me-2"></i> Modifier le Patient
        </h1>
        <p class="page-subtitle mb-0">Mettez à jour la fiche de {{ patient.prenomPatient }} {{ patient.nomPatient }}</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_patient_index') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
        <a href="{{ path('app_patient_show', {'idPatient': patient.idPatient}) }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-eye me-1"></i> Voir la fiche
        </a>
        {{ include('patient/_delete_form.html.twig') }}
    </div>
</div>

<!-- Formulaire -->
<div class="row">
    <div class="col-12">
        {{ include('patient/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>
</div>
{% endblock %}