{% extends 'base.html.twig' %}

{% block title %}Dossier Patient - {{ patient.prenomPatient }} {{ patient.nomPatient }}{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-primary text-white rounded-circle p-3 me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
            <span class="fs-3 fw-bold">{{ patient.prenomPatient|first|upper }}{{ patient.nomPatient|first|upper }}</span>
        </div>
        <div>
            <h1 class="h2 page-title mb-1">
                {{ patient.prenomPatient }} {{ patient.nomPatient }}
            </h1>
            <p class="page-subtitle mb-0">Dossier médical patient #{{ patient.idPatient }}</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_patient_index') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
        <a href="{{ path('app_patient_edit', {'idPatient': patient.idPatient}) }}" class="btn btn-warning shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
        {{ include('patient/_delete_form.html.twig') }}
    </div>
</div>

<div class="row g-4">
    <!-- Colonne Principale: Infos et Mutuelles -->
    <div class="col-lg-8">
        
        <!-- Informations Personnelles -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-info-circle text-primary me-2"></i> Informations Personnelles
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <small class="text-muted fw-bold text-uppercase d-block mb-1">Nom complet</small>
                                <div class="fs-5 text-dark fw-medium">{{ patient.prenomPatient }} {{ patient.nomPatient }}</div>
                            </div>
                            <div>
                                <small class="text-muted fw-bold text-uppercase d-block mb-1">Date de naissance</small>
                                <div class="fs-6 text-dark">
                                    {{ patient.dateNaissance ? patient.dateNaissance|date('d/m/Y') : 'Non renseignée' }}
                                    {% if patient.dateNaissance %}
                                        <span class="badge bg-light text-dark border ms-2">{{ date().diff(date(patient.dateNaissance)).y }} ans</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <small class="text-muted fw-bold text-uppercase d-block mb-1">Adresse postale</small>
                                <div class="fs-6 text-dark">
                                    <i class="bi bi-geo-alt text-muted me-2"></i>{{ patient.adressePatient }}
                                </div>
                            </div>
                            <div>
                                <small class="text-muted fw-bold text-uppercase d-block mb-1">Identifiant</small>
                                <div class="fs-6 text-dark font-monospace text-muted">ID-{{ '%06d'|format(patient.idPatient|default(0)) }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section Mutuelles -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-shield-check text-info me-2"></i> Couverture Santé
                </h5>
                <a href="{{ path('app_mutuelle_index') }}" class="btn btn-sm btn-outline-info">Gérer les mutuelles</a>
            </div>
            <div class="card-body p-4">
                {% if patient.mutuelles|length > 0 %}
                    <div class="row g-3">
                        {% for mutuelle in patient.mutuelles %}
                        <div class="col-md-6">
                            <div class="card border border-info border-opacity-25 bg-info bg-opacity-10 h-100">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="card-title fw-bold text-dark mb-0">
                                            <i class="bi bi-shield-plus text-info me-2"></i>{{ mutuelle.nomMutuelle }}
                                        </h6>
                                        <span class="badge bg-info">{{ mutuelle.tauxRemboursement }}%</span>
                                    </div>
                                    <p class="card-text small text-muted mb-0">
                                        <i class="bi bi-telephone me-1"></i> {{ mutuelle.contactMutuelle }}
                                    </p>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-4">
                        <i class="bi bi-shield-slash display-4 text-muted opacity-25 d-block mb-3"></i>
                        <h6 class="text-muted">Aucune mutuelle associée</h6>
                        <p class="text-muted small">Ce patient n'a pas de couverture santé enregistrée.</p>
                    </div>
                {% endif %}
            </div>
        </div>

    </div>

    <!-- Colonne Latérale: Statistiques et Actions -->
    <div class="col-lg-4">
        <!-- Carte des statistiques -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h6 class="text-uppercase text-muted fw-bold mb-4">Aperçu du dossier</h6>
                
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                        <i class="bi bi-file-medical fs-3"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold text-dark lh-1">{{ patient.ordonnances|length }}</div>
                        <small class="text-muted text-uppercase fw-medium">Ordonnances</small>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3 me-3">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <div>
                        <div class="fs-3 fw-bold text-dark lh-1">{{ patient.mutuelles|length }}</div>
                        <small class="text-muted text-uppercase fw-medium">Mutuelles</small>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light border-0 p-3">
                <div class="d-grid">
                    <a href="{{ path('app_ordonnance_new') }}" class="btn btn-success shadow-sm">
                        <i class="bi bi-plus-lg me-2"></i>Nouvelle ordonnance
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section Ordonnances -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-file-medical text-success me-2"></i> Historique des Ordonnances
                </h5>
            </div>
            <div class="card-body p-0">
                {% if patient.ordonnances|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 border-0">N° Ord.</th>
                                <th class="border-0">Date</th>
                                <th class="border-0">Médecin Prescripteur</th>
                                <th class="border-0">Durée</th>
                                <th class="border-0">Produits</th>
                                <th class="border-0 text-center pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ordonnance in patient.ordonnances %}
                            <tr>
                                <td class="ps-4 fw-bold text-dark">#{{ ordonnance.id }}</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-calendar3 me-1"></i>{{ ordonnance.dateOrdonnance ? ordonnance.dateOrdonnance|date('d/m/Y') : 'N/A' }}
                                    </span>
                                </td>
                                <td>
                                    {% if ordonnance.medecin %}
                                        <div class="fw-medium text-dark">Dr. {{ ordonnance.medecin.prenomMedecin }} {{ ordonnance.medecin.nomMedecin }}</div>
                                    {% else %}
                                        <span class="text-muted fst-italic">Non spécifié</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if ordonnance.validForFirstDispense %}
                                        <span class="badge bg-success bg-opacity-10 text-success">Valide</span>
                                    {% else %}
                                        <span class="badge bg-danger bg-opacity-10 text-danger">Expirée</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if ordonnance.lignes|length > 0 %}
                                        {{ ordonnance.lignes|length }} médicament(s)
                                    {% else %}
                                        <span class="text-muted small">Aucun médicament</span>
                                    {% endif %}
                                </td>
                                <td class="text-center pe-4">
                                    <a href="{{ path('app_ordonnance_show', {'id': ordonnance.id}) }}" class="btn btn-sm btn-light border" title="Voir">
                                        <i class="bi bi-eye text-primary"></i>
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-file-medical display-4 text-muted opacity-25 d-block mb-3"></i>
                    <h5 class="text-muted">Aucune ordonnance</h5>
                    <p class="text-muted small">L'historique médical de ce patient est vide.</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}