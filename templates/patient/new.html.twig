{% extends 'base.html.twig' %}

{% block title %}Nouveau Patient - Jeffarma{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-person-plus text-primary me-2"></i> Nouveau Patient
        </h1>
        <p class="page-subtitle mb-0">Ajoutez un nouveau patient à votre base de données</p>
    </div>
    <div>
        <a href="{{ path('app_patient_index') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
    </div>
</div>

<!-- Formulaire -->
<div class="row">
    <div class="col-12">
        {{ include('patient/_form.html.twig') }}
    </div>
</div>
{% endblock %}