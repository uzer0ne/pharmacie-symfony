{% extends 'base.html.twig' %}

{% block title %}Patients - Jeffarma{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-people text-primary me-2"></i> Gestion des Patients
        </h1>
        <p class="page-subtitle mb-0">Annuaire de votre patientèle</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_mutuelle_index') }}" class="btn btn-outline-info shadow-sm">
            <i class="bi bi-shield-plus me-1"></i> Mutuelles
        </a>
        <a href="{{ path('app_patient_new') }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nouveau Patient
        </a>
    </div>
</div>

<!-- Tableau des patients -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        {% if patients|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 border-0">N° Dossier</th>
                        <th class="border-0">Patient</th>
                        <th class="border-0">Âge</th>
                        <th class="border-0">Mutuelles</th>
                        <th class="border-0 text-center">Ordonnances</th> 
                        <th class="border-0 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for patient in patients %}
                    <tr>
                        <td class="ps-4 text-muted">#{{ patient.idPatient }}</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                    <span class="fw-bold fs-5">{{ patient.prenomPatient|first|upper }}{{ patient.nomPatient|first|upper }}</span>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">{{ patient.prenomPatient }} {{ patient.nomPatient }}</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>{{ patient.adressePatient|length > 30 ? patient.adressePatient|slice(0, 30) ~ '...' : patient.adressePatient }}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if patient.dateNaissance %}
                                <div class="fw-medium text-dark">{{ date().diff(date(patient.dateNaissance)).y }} ans</div>
                                <small class="text-muted">{{ patient.dateNaissance|date('d/m/Y') }}</small>
                            {% else %}
                                <span class="text-muted fst-italic">Non renseigné</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if patient.mutuelles|length > 0 %}
                                <div class="d-flex flex-wrap gap-1">
                                    {% for mutuelle in patient.mutuelles %}
                                        <a href="{{ path('app_mutuelle_show', {'id': mutuelle.id}) }}" 
                                           class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 text-decoration-none" 
                                           data-bs-toggle="tooltip" 
                                           title="Voir {{ mutuelle.nomMutuelle }} - Taux: {{ mutuelle.tauxRemboursement }}%">
                                            <i class="bi bi-shield-check me-1"></i>{{ mutuelle.nomMutuelle }} ({{ mutuelle.tauxRemboursement }}%)
                                        </a>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="badge bg-light text-muted border">Aucune</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            {% if patient.ordonnances|length > 0 %}
                                <a href="{{ path('app_ordonnance_index') }}?patient={{ patient.idPatient }}" 
                                    class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 text-decoration-none px-2 py-1 fs-6"
                                    data-bs-toggle="tooltip" 
                                    title="Voir les {{ patient.ordonnances|length }} ordonnances">    
                                    <i class="bi bi-file-medical"></i> {{ patient.ordonnances|length }}
                                </a>
                            {% else %}
                                <span class="text-muted opacity-50">-</span>
                            {% endif %}
                        </td>
                        <td class="text-center pe-4">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_patient_show', {'idPatient': patient.idPatient}) }}">
                                            <i class="bi bi-person-lines-fill text-primary me-2"></i> Dossier patient
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_patient_edit', {'idPatient': patient.idPatient}) }}">
                                            <i class="bi bi-pencil text-warning me-2"></i> Modifier
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_ordonnance_new') }}">
                                            <i class="bi bi-file-medical text-success me-2"></i> Nouvelle ordonnance
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="px-4 pb-3">
            {{ include('partials/_pagination.html.twig', { items: patients }) }}
        </div>
        {% else %}
        {{ include('partials/_empty_state.html.twig', {
            icon: 'people',
            title: 'Aucun patient enregistré',
            subtitle: 'Commencez par ajouter votre premier patient pour suivre son dossier et ses ordonnances.',
            action: { label: 'Ajouter un Patient', path: 'app_patient_new', icon: 'person-plus' }
        }) }}
        {% endif %}
    </div>
</div>

<!-- Script pour les tooltips -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>
{% endblock %}