{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row g-4">
    <!-- Colonne Principale -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i> Informations Personnelles
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.prenom_patient, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
                            {{ form_label(form.prenom_patient, 'Prénom *') }}
                            {{ form_errors(form.prenom_patient) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.nom_patient, {'attr': {'class': 'form-control fw-bold text-dark', 'placeholder': 'Nom'}}) }}
                            {{ form_label(form.nom_patient, 'Nom *') }}
                            {{ form_errors(form.nom_patient) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.date_naissance, {'attr': {'class': 'form-control', 'placeholder': 'Date de Naissance'}}) }}
                            {{ form_label(form.date_naissance, 'Date de Naissance *') }}
                            {{ form_errors(form.date_naissance) }}
                        </div>
                    </div>
                </div>

                <hr class="my-4">
                
                <h6 class="text-dark fw-bold mb-3"><i class="bi bi-geo-alt text-primary me-2"></i>Coordonnées</h6>
                <div class="form-floating mb-3">
                    {{ form_widget(form.adresse_patient, {'attr': {'class': 'form-control', 'placeholder': 'Adresse complète', 'style': 'height: 100px'}}) }}
                    {{ form_label(form.adresse_patient, 'Adresse complète *') }}
                    {{ form_errors(form.adresse_patient) }}
                </div>
            </div>
        </div>
    </div>

    <!-- Colonne Latérale -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-shield-check text-primary me-2"></i> Assurance & Mutuelle
                </h5>
            </div>
            <div class="card-body p-4">
                {% if form.mutuelles is defined %}
                    <div class="mb-4">
                        {{ form_label(form.mutuelles, 'Mutuelles associées', {'label_attr': {'class': 'fw-medium mb-2 text-dark'}}) }}
                        {{ form_widget(form.mutuelles, {'attr': {'class': 'form-select', 'size': 5}}) }}
                        <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Maintenez Ctrl (ou Cmd) pour sélectionner plusieurs mutuelles.</div>
                    </div>
                {% else %}
                    <div class="alert alert-light text-muted">
                        <i class="bi bi-shield-slash me-2"></i> Aucune mutuelle disponible.
                    </div>
                {% endif %}

                <div class="d-grid mt-4">
                    <a href="{{ path('app_mutuelle_new') }}" target="_blank" class="btn btn-outline-primary btn-sm border-dashed">
                        <i class="bi bi-plus-lg me-1"></i> Créer une mutuelle
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
    <a href="{{ path('app_patient_index') }}" class="btn btn-light text-muted fw-bold px-4 py-2">
        Annuler
    </a>
    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 shadow-sm">
        {{ button_label|default('Enregistrer le Patient') }}
    </button>
</div>

{{ form_end(form) }}

<style>
/* Surcharge locale pour les floating labels avec validation Symfony */
.form-floating > .form-control:focus ~ label,
.form-floating > .form-control:not(:placeholder-shown) ~ label {
    color: var(--color-primary);
    transform: scale(.85) translateY(-.5rem) translateX(.15rem);
}
.form-floating > .form-control {
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
}
.form-floating > .form-control:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.15); /* Vert émeraude */
}
.border-dashed {
    border-style: dashed !important;
}
</style>