{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row g-4">
    <!-- Colonne Principale -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i> Informations Personnelles
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.prenom_patient, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
                            {{ form_label(form.prenom_patient, 'Prénom *') }}
                            {{ form_errors(form.prenom_patient) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.nom_patient, {'attr': {'class': 'form-control fw-bold text-dark', 'placeholder': 'Nom'}}) }}
                            {{ form_label(form.nom_patient, 'Nom *') }}
                            {{ form_errors(form.nom_patient) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.date_naissance, {'attr': {'class': 'form-control', 'placeholder': 'Date de Naissance'}}) }}
                            {{ form_label(form.date_naissance, 'Date de Naissance *') }}
                            {{ form_errors(form.date_naissance) }}
                        </div>
                    </div>
                </div>

                <hr class="my-4">
                
                <h6 class="text-dark fw-bold mb-3"><i class="bi bi-geo-alt text-primary me-2"></i>Coordonnées</h6>
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Téléphone'}}) }}
                            {{ form_label(form.telephone, 'Téléphone') }}
                            {{ form_errors(form.telephone) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Email'}}) }}
                            {{ form_label(form.email, 'Email') }}
                            {{ form_errors(form.email) }}
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    {{ form_widget(form.adresse_patient, {'attr': {'class': 'form-control', 'placeholder': 'Adresse complète', 'style': 'height: 100px'}}) }}
                    {{ form_label(form.adresse_patient, 'Adresse complète *') }}
                    {{ form_errors(form.adresse_patient) }}
                </div>
            </div>
        </div>
    </div>

    <!-- Colonne Latérale -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-shield-check text-primary me-2"></i> Assurance Maladie
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="form-floating mb-3">
                    {{ form_widget(form.nir, {'attr': {'class': 'form-control', 'placeholder': 'NIR'}}) }}
                    {{ form_label(form.nir, 'N° de Sécurité Sociale') }}
                    {{ form_errors(form.nir) }}
                </div>
                <div class="form-text text-muted mb-4">
                    <i class="bi bi-info-circle me-1"></i> Le numéro de sécurité sociale (NIR) comporte 15 chiffres.
                </div>
                
                <div class="alert alert-info bg-info bg-opacity-10 border-info border-opacity-25 small mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i> Les contrats de mutuelle pourront être ajoutés sur la fiche du patient une fois celle-ci créée.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
    <a href="{{ path('app_patient_index') }}" class="btn btn-light text-muted fw-bold px-4 py-2">
        Annuler
    </a>
    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 shadow-sm">
        {{ button_label|default('Enregistrer le Patient') }}
    </button>
</div>

{{ form_end(form) }}

<style>
/* Surcharge locale pour les floating labels avec validation Symfony */
.form-floating > .form-control:focus ~ label,
.form-floating > .form-control:not(:placeholder-shown) ~ label {
    color: var(--color-primary);
    transform: scale(.85) translateY(-.5rem) translateX(.15rem);
}
.form-floating > .form-control {
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
}
.form-floating > .form-control:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.15); /* Vert émeraude */
}
.border-dashed {
    border-style: dashed !important;
}
</style>