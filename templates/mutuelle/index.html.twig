{% extends 'base.html.twig' %}

{% block title %}Mutuelles - Jeffarma{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-shield-check text-primary me-2"></i> Assurances & Mutuelles
        </h1>
        <p class="page-subtitle mb-0">Gérez vos partenaires de santé et mutuelles</p>
    </div>
    <div>
        <a href="{{ path('app_mutuelle_new') }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nouvelle Mutuelle
        </a>
    </div>
</div>

<!-- Tableau des mutuelles -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        {% if mutuelles|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 border-0">N°</th>
                        <th class="border-0">Mutuelle</th>
                        <th class="border-0">Taux de couverture</th>
                        <th class="border-0">Contact</th>
                        <th class="border-0 text-center">Patients</th>
                        <th class="border-0 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for mutuelle in mutuelles %}
                    <tr>
                        <td class="ps-4 text-muted">#{{ mutuelle.id }}</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-building fs-5"></i>
                                </div>
                                <div class="fw-bold text-dark fs-6">{{ mutuelle.nomMutuelle }}</div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 me-2 px-2 py-1 fs-6">
                                    {{ mutuelle.tauxRemboursement }}%
                                </span>
                            </div>
                        </td>
                        <td>
                            <div class="text-dark"><i class="bi bi-telephone text-muted me-2"></i>{{ mutuelle.contactMutuelle }}</div>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                <i class="bi bi-people-fill text-muted me-1"></i> {{ mutuelle.patients|length }}
                            </span>
                        </td>
                        <td class="text-center pe-4">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_mutuelle_show', {'id': mutuelle.id}) }}">
                                            <i class="bi bi-eye text-primary me-2"></i> Voir la fiche
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_mutuelle_edit', {'id': mutuelle.id}) }}">
                                            <i class="bi bi-pencil text-warning me-2"></i> Modifier
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="px-4 pb-3">
            {{ include('partials/_pagination.html.twig', { items: mutuelles }) }}
        </div>
        {% else %}
        <div class="text-center py-5">
            <i class="bi bi-shield-slash display-1 text-muted opacity-25 d-block mb-3"></i>
            <h4 class="text-muted">Aucune mutuelle enregistrée</h4>
            <p class="text-muted mb-4">Ajoutez des partenaires de santé pour gérer la couverture de vos patients.</p>
            <a href="{{ path('app_mutuelle_new') }}" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Ajouter une Mutuelle
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}