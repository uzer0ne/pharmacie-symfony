{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-shield-check text-primary me-2"></i> Informations de la Mutuelle
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.nom_mutuelle, {'attr': {'class': 'form-control fw-bold text-dark', 'placeholder': 'Nom de la mutuelle'}}) }}
                            {{ form_label(form.nom_mutuelle, 'Nom de la mutuelle *') }}
                            {{ form_errors(form.nom_mutuelle) }}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.taux_remboursement, {'attr': {'class': 'form-control text-success fw-bold', 'placeholder': 'Taux (%)'}}) }}
                            {{ form_label(form.taux_remboursement, 'Taux (%) *') }}
                            {{ form_errors(form.taux_remboursement) }}
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    {{ form_widget(form.contact_mutuelle, {'attr': {'class': 'form-control', 'placeholder': 'Contact (Téléphone/Email)'}}) }}
                    {{ form_label(form.contact_mutuelle, 'Contact (Téléphone/Email) *') }}
                    {{ form_errors(form.contact_mutuelle) }}
                </div>
                
                {% if form.patients is defined %}
                <hr class="my-4">
                <h6 class="text-dark fw-bold mb-3"><i class="bi bi-people text-primary me-2"></i>Patients Associés</h6>
                <div class="mb-3">
                    {{ form_widget(form.patients, {'attr': {'class': 'form-select', 'size': 5}}) }}
                    <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Maintenez Ctrl (ou Cmd) pour sélectionner plusieurs patients.</div>
                    {{ form_errors(form.patients) }}
                </div>
                {% endif %}
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
            <a href="{{ path('app_mutuelle_index') }}" class="btn btn-light text-muted fw-bold px-4 py-2">
                Annuler
            </a>
            <button type="submit" class="btn btn-primary fw-bold px-5 py-2 shadow-sm">
                {{ button_label|default('Enregistrer la Mutuelle') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}

<style>
.form-floating > .form-control:focus ~ label,
.form-floating > .form-control:not(:placeholder-shown) ~ label {
    color: var(--color-primary);
    transform: scale(.85) translateY(-.5rem) translateX(.15rem);
}
.form-floating > .form-control {
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
}
.form-floating > .form-control:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.15);
}
</style>