{% extends 'base.html.twig' %}

{% block title %}Fiche Mutuelle - {{ mutuelle.nomMutuelle }}{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-primary text-white rounded-circle p-3 me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 64px; height: 64px;">
            <i class="bi bi-building fs-2"></i>
        </div>
        <div>
            <h1 class="h2 page-title mb-1">
                {{ mutuelle.nomMutuelle }}
            </h1>
            <p class="page-subtitle mb-0">Partenaire Santé #{{ mutuelle.id }}</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_mutuelle_index') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
        <a href="{{ path('app_mutuelle_edit', {'id': mutuelle.id}) }}" class="btn btn-warning shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
        {{ include('mutuelle/_delete_form.html.twig') }}
    </div>
</div>

<div class="row g-4">
    <!-- Colonne Principale -->
    <div class="col-lg-8">
        
        <!-- Informations -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-info-circle text-primary me-2"></i> Informations de la Mutuelle
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <small class="text-muted fw-bold text-uppercase d-block mb-1">Nom officiel</small>
                                <div class="fs-5 text-dark fw-medium">{{ mutuelle.nomMutuelle }}</div>
                            </div>
                            <div>
                                <small class="text-muted fw-bold text-uppercase d-block mb-1">Taux de couverture</small>
                                <div class="fs-4 text-success fw-bold">
                                    {{ mutuelle.tauxRemboursement }}%
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex flex-column gap-3">
                            <div>
                                <small class="text-muted fw-bold text-uppercase d-block mb-1">Contact Principal</small>
                                <div class="fs-6 text-dark">
                                    <i class="bi bi-telephone text-muted me-2"></i>{{ mutuelle.contactMutuelle }}
                                </div>
                            </div>
                            <div>
                                <small class="text-muted fw-bold text-uppercase d-block mb-1">Identifiant Système</small>
                                <div class="fs-6 text-dark font-monospace text-muted">MUT-{{ '%06d'|format(mutuelle.id|default(0)) }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section Patients -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-people text-info me-2"></i> Patients Associés
                </h5>
                <span class="badge bg-light text-dark border">{{ mutuelle.patients|length }} patient(s)</span>
            </div>
            <div class="card-body p-0">
                {% if mutuelle.patients|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 border-0">ID Patient</th>
                                <th class="border-0">Nom complet</th>
                                <th class="border-0 text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for patient in mutuelle.patients %}
                            <tr>
                                <td class="ps-4 text-muted">#{{ patient.idPatient }}</td>
                                <td>
                                    <div class="fw-medium text-dark">{{ patient.prenomPatient }} {{ patient.nomPatient }}</div>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="{{ path('app_patient_show', {'idPatient': patient.idPatient}) }}" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye me-1"></i> Dossier
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-people display-4 text-muted opacity-25 d-block mb-3"></i>
                    <h5 class="text-muted">Aucun patient n'est associé à cette mutuelle.</h5>
                </div>
                {% endif %}
            </div>
        </div>

    </div>

    <!-- Colonne Latérale: Statistiques -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4 bg-primary bg-opacity-10">
            <div class="card-body p-4 text-center">
                <div class="bg-white rounded-circle p-3 d-inline-block shadow-sm mb-3">
                    <i class="bi bi-pie-chart text-primary fs-2"></i>
                </div>
                <h6 class="text-uppercase text-primary fw-bold mb-1">Couverture</h6>
                <div class="display-4 fw-bold text-dark">{{ mutuelle.tauxRemboursement }}%</div>
                
                <div class="progress mt-3 bg-white shadow-sm" style="height: 12px; border-radius: 6px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: {{ mutuelle.tauxRemboursement }}%;" aria-valuenow="{{ mutuelle.tauxRemboursement }}" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}