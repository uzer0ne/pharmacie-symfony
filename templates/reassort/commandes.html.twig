{% extends 'base.html.twig' %}

{% block title %}Historique des commandes fournisseur{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h4 class="h4 page-title mb-0">
            <i class="bi bi-truck text-primary me-2"></i> Commandes fournisseur
        </h4>
        <p class="page-subtitle mb-0 small text-muted">Historique de toutes les commandes générées</p>
    </div>
    <a href="{{ path('app_reassort_index') }}" class="btn btn-warning btn-sm fw-bold shadow-sm">
        <i class="bi bi-arrow-repeat me-1"></i> Analyser le stock
    </a>
</div>

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show" role="alert">
            {{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="card border-0 shadow-sm">
    {% if commandes is empty %}
        <div class="card-body py-5 text-center text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
            <h5>Aucune commande générée</h5>
            <a href="{{ path('app_reassort_index') }}" class="btn btn-warning btn-sm mt-2">
                <i class="bi bi-arrow-repeat me-1"></i> Lancer l'analyse de réassort
            </a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Date de création</th>
                        <th class="text-center">Statut</th>
                        <th class="text-center">Nb de lignes</th>
                        <th class="text-end">Montant total</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td class="fw-bold text-muted">#{{ commande.id }}</td>
                        <td>{{ commande.dateCreation|date('d/m/Y à H:i') }}</td>
                        <td class="text-center">
                            {% if commande.statut == 'BROUILLON' %}
                                <span class="badge bg-secondary">
                                    <i class="bi bi-pencil me-1"></i> Brouillon
                                </span>
                            {% elseif commande.statut == 'ENVOYEE' %}
                                <span class="badge bg-primary">
                                    <i class="bi bi-send-fill me-1"></i> Envoyée
                                </span>
                            {% else %}
                                <span class="badge bg-success">
                                    <i class="bi bi-check2-all me-1"></i> Réceptionnée
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-center">{{ commande.lignes|length }}</td>
                        <td class="text-end fw-bold">{{ commande.montantTotal|number_format(2, ',', ' ') }} €</td>
                        <td class="text-center">
                            <a href="{{ path('app_reassort_show', {id: commande.id}) }}" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1"></i> Voir
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
