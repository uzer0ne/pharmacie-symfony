{% extends 'base.html.twig' %}
{% block title %}Commande #{{ commande.id }}{% endblock %}

{% block body %}
{% set s = commande.statut %}

{# Couleurs et icônes selon le statut #}
{% set statutCfg = {
    'BROUILLON':    {color: 'secondary', icon: 'pencil',         label: 'Brouillon'},
    'A_VALIDER':    {color: 'info',      icon: 'hourglass-split', label: 'En attente de validation'},
    'VALIDEE':      {color: 'primary',   icon: 'check2-circle',   label: 'Validée'},
    'ENVOYEE':      {color: 'warning',   icon: 'send-fill',       label: 'Envoyée'},
    'RECEPTIONNEE': {color: 'success',   icon: 'check2-all',      label: 'Réceptionnée'},
} %}
{% set cfg = statutCfg[s] ?? {color: 'secondary', icon: 'question', label: s} %}

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        <h4 class="h4 page-title mb-0">
            <i class="bi bi-truck text-primary me-2"></i> Commande fournisseur #{{ commande.id }}
            {% if commande.fournisseur %}
                <span class="fs-6 text-muted ms-2">chez {{ commande.fournisseur.nom }}</span>
            {% endif %}
        </h4>
        <p class="page-subtitle mb-0 small text-muted">
            Créée le {{ commande.dateCreation|date('d/m/Y à H:i') }}
            &nbsp;·&nbsp;
            <span class="badge bg-{{ cfg.color }}">
                <i class="bi bi-{{ cfg.icon }} me-1"></i>{{ cfg.label }}
            </span>
        </p>
    </div>
    <a href="{{ path('app_reassort_commandes') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Retour
    </a>
</div>

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show">
            {{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="row g-3">

    {# ── Tableau des lignes ── #}
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom pt-3 pb-3 px-4">
                <h6 class="mb-0 fw-bold"><i class="bi bi-list-ul me-2 text-primary"></i>Lignes de commande</h6>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Produit</th>
                            <th class="text-center">Qté commandée</th>
                            <th class="text-end">PU achat</th>
                            <th class="text-end">Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for ligne in commande.lignes %}
                        <tr>
                            <td>
                                <a href="{{ path('app_produit_show', {idProduit: ligne.produit.id}) }}"
                                   class="fw-bold text-dark text-decoration-none">
                                    {{ ligne.produit.nomProduit }}
                                </a>
                                <br><small class="text-muted">{{ ligne.produit.dosageProduit }}</small>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-warning text-dark fs-6">{{ ligne.quantiteCommandee }}</span>
                            </td>
                            <td class="text-end text-muted small">
                                {{ ligne.prixAchatUnitaire ? ligne.prixAchatUnitaire|number_format(2, ',', ' ') ~ ' €' : '—' }}
                            </td>
                            <td class="text-end fw-bold">
                                {{ ligne.montantLigne|number_format(2, ',', ' ') }} €
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">TOTAL ESTIMÉ</td>
                            <td class="text-end fw-bold text-success fs-5">
                                {{ commande.montantTotal|number_format(2, ',', ' ') }} €
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    {# ── Panneau workflow ── #}
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-3">
                <h6 class="fw-bold mb-3">
                    <i class="bi bi-diagram-3 me-2 text-secondary"></i>Workflow commande
                </h6>

                {# Timeline des étapes #}
                {% set etapes = [
                    {statuts: ['BROUILLON','A_VALIDER','VALIDEE','ENVOYEE','RECEPTIONNEE'], label: '1. Brouillon créé',     icon: 'pencil'},
                    {statuts: ['A_VALIDER','VALIDEE','ENVOYEE','RECEPTIONNEE'],             label: '2. Soumis au pharmacien', icon: 'hourglass-split'},
                    {statuts: ['VALIDEE','ENVOYEE','RECEPTIONNEE'],                          label: '3. Validé (pharmacien)', icon: 'check2-circle'},
                    {statuts: ['ENVOYEE','RECEPTIONNEE'],                                    label: '4. Envoyé au grossiste', icon: 'send-fill'},
                    {statuts: ['RECEPTIONNEE'],                                              label: '5. Réceptionné ✔',       icon: 'check2-all'},
                ] %}

                <div class="d-flex flex-column gap-1 mb-3">
                {% for etape in etapes %}
                    {% set done = s in etape.statuts %}
                    {% set current = (
                        (s == 'BROUILLON'    and etape.label starts with '1') or
                        (s == 'A_VALIDER'    and etape.label starts with '2') or
                        (s == 'VALIDEE'      and etape.label starts with '3') or
                        (s == 'ENVOYEE'      and etape.label starts with '4') or
                        (s == 'RECEPTIONNEE' and etape.label starts with '5')
                    ) %}
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-{{ etape.icon }} {% if current %}text-primary{% elseif done %}text-success{% else %}text-muted{% endif %}"
                           style="font-size: {% if current %}1.1rem{% else %}0.9rem{% endif %};"></i>
                        <span class="{% if current %}fw-bold text-primary{% elseif done %}text-success{% else %}text-muted{% endif %}"
                              style="font-size: 0.85rem;">
                            {{ etape.label }}
                        </span>
                        {% if done and not current %}
                            <i class="bi bi-check text-success ms-auto" style="font-size: 0.8rem;"></i>
                        {% endif %}
                    </div>
                {% endfor %}
                </div>

                <hr class="my-2">

                {# Boutons d'action selon le statut et le rôle #}

                {# BROUILLON → Soumettre (gestionnaire) #}
                {% if s == 'BROUILLON' %}
                    <form action="{{ path('app_reassort_soumettre', {id: commande.id}) }}" method="POST">
                        <input type="hidden" name="_token" value="{{ csrf_token('soumettre_' ~ commande.id) }}">
                        <button type="submit" class="btn btn-info w-100 fw-bold text-white">
                            <i class="bi bi-send me-2"></i> Soumettre au pharmacien
                        </button>
                    </form>

                {# A_VALIDER → Valider (pharmacien uniquement) #}
                {% elseif s == 'A_VALIDER' %}
                    <form action="{{ path('app_reassort_valider', {id: commande.id}) }}" method="POST">
                            <input type="hidden" name="_token" value="{{ csrf_token('valider_' ~ commande.id) }}">
                            <button type="submit" class="btn btn-primary w-100 fw-bold">
                                <i class="bi bi-check2-circle me-2"></i> Valider la commande
                            </button>
                        </form>

                {# VALIDEE → Envoyer (pharmacien uniquement) #}
                {% elseif s == 'VALIDEE' %}
                    <form action="{{ path('app_reassort_envoyer', {id: commande.id}) }}" method="POST">
                            <input type="hidden" name="_token" value="{{ csrf_token('envoyer_commande_' ~ commande.id) }}">
                            <button type="submit" class="btn btn-warning w-100 fw-bold">
                                <i class="bi bi-send-fill me-2"></i> Envoyer au grossiste-répartiteur
                            </button>
                        </form>

                {# ENVOYEE → Réceptionner (gestionnaire) #}
                {% elseif s == 'ENVOYEE' %}
                    <a href="{{ path('app_reassort_receptionner', {id: commande.id}) }}" class="btn btn-success w-100 fw-bold">
                        <i class="bi bi-box-arrow-in-down me-2"></i> Pointer la livraison
                    </a>
                    <small class="text-muted d-block text-center mt-1" style="font-size: 0.7rem;">
                        Permet d'ajuster les quantités reçues et les dates de péremption.
                    </small>

                {# RECEPTIONNEE → Terminée #}
                {% else %}
                    <div class="alert alert-success py-2 mb-0 text-center small fw-bold">
                        <i class="bi bi-check-circle-fill me-1"></i> Commande clôturée — stocks mis à jour
                    </div>
                {% endif %}
            </div>
        </div>

        {# Résumé chiffres #}
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted small">Nombre de lignes</span>
                    <strong>{{ commande.lignes|length }}</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Montant total estimé</span>
                    <strong class="text-success">{{ commande.montantTotal|number_format(2, ',', ' ') }} €</strong>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
