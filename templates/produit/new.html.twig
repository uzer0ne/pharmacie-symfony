{% extends 'base.html.twig' %}

{% block title %}Nouveau Produit - PharmaGest{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-plus-square text-primary me-2"></i> Nouveau Produit
        </h1>
        <p class="page-subtitle mb-0">Ajoutez un nouveau produit à votre inventaire</p>
    </div>
    <div>
        <a href="{{ path('app_produit_index') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>
</div>

<!-- Formulaire -->
{{ include('produit/_form.html.twig') }}

<!-- Informations supplémentaires -->
<div class="card bg-info bg-opacity-10 border-0 shadow-sm mt-4">
    <div class="card-body">
        <h6 class="text-info fw-bold mb-3"><i class="bi bi-info-circle me-2"></i> Informations importantes</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <p class="small text-dark mb-0"><i class="bi bi-shield-check text-success me-1"></i> Les champs marqués d'un astérisque (*) sont obligatoires.</p>
            </div>
            <div class="col-md-6">
                <p class="small text-dark mb-0"><i class="bi bi-boxes text-primary me-1"></i> Vous pourrez gérer les stocks précisément après la création.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}