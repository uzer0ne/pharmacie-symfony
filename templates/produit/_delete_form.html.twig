<form method="post" action="{{ path('app_produit_delete', {'idProduit': produit.id}) }}" 
      class="d-inline-block"
      data-controller="modal-form"
      data-action="submit->modal-form#confirm"
      data-modal-form-title-value="Supprimer le produit"
      data-modal-form-text-value="Êtes-vous sûr de vouloir supprimer définitivement le produit '{{ produit.nomProduit }}' ?">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
    <button class="btn btn-danger shadow-sm">
        <i class="bi bi-trash"></i> Supprimer
    </button>
</form>
