{% extends 'base.html.twig' %}

{% block title %}Produits - Jeffarma{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-box-seam text-primary me-2"></i> Gestion des Produits
        </h1>
        <p class="page-subtitle mb-0">Gérez votre inventaire et vos stocks</p>
    </div>
    {% if is_granted('ROLE_GESTIONNAIRE_STOCK') %}
    <div>
        <a href="{{ path('app_produit_new') }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nouveau Produit
        </a>
    </div>
    {% endif %}
</div>

<!-- Cartes d'alertes & KPIs -->
<div class="row mb-4 g-3">
    <!-- 1. RÉFÉRENCES ACTIVES (Vert) -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 border-start border-success border-4 h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-success text-uppercase mb-1">
                            Références actives
                        </div>
                        <div class="h3 mb-0 fw-bold text-dark">{{ produits.getTotalItemCount() }}</div>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-boxes fs-3 text-success"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">Produits dans le catalogue</div>
            </div>
        </div>
    </div>

    <!-- 2. VALEUR DU STOCK (Bleu) -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 border-start border-primary border-4 h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-primary text-uppercase mb-1">
                            Valeur du stock 
                        </div>
                        <div class="h3 mb-0 fw-bold text-dark">{{ stats.valeur_stock|number_format(0, ',', ' ') }} €</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-currency-euro fs-3 text-primary"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">Basé sur les prix d'achat</div>
            </div>
        </div>
    </div>

    <!-- 3. COURTES DATES (Orange/Jaune) -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 border-start border-warning border-4 h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-warning text-uppercase mb-1">
                            Courtes dates
                        </div>
                        <div class="h3 mb-0 fw-bold text-dark">{{ stats.expiration }}</div>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-calendar-x fs-3 text-warning"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">Péremption dans < 3 mois</div>
            </div>
        </div>
    </div>

    <!-- 4. À COMMANDER (Rouge) -->
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 border-start border-danger border-4 h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-xs fw-bold text-danger text-uppercase mb-1">
                            À commander
                        </div>
                        <div class="h3 mb-0 fw-bold text-dark">{{ stats.a_commander }}</div>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                        <i class="bi bi-cart-x fs-3 text-danger"></i>
                    </div>
                </div>
                <div class="mt-2 text-muted small">Produits sous le seuil d'alerte</div>
            </div>
        </div>
    </div>
</div>

<!-- Tableau des produits -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        {% if produits|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 border-0">Statut</th>
                        <th class="border-0">Produit</th>
                        <th class="border-0">Code CIP</th>
                        <th class="border-0">Dosage</th>
                        <th class="border-0" style="min-width: 150px;">Stock</th>
                        <th class="border-0 text-end">Prix</th>
                        <th class="border-0">Expiration</th>
                        <th class="border-0 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for produit in produits %}
                    <tr class="{% if produit.estEnRupture() %}table-danger-subtle{% elseif produit.estStockCritique() %}table-warning-subtle{% endif %}">
                        <td class="ps-4">
                            <span class="badge bg-{{ produit.couleurStatutStock }} bg-opacity-75" 
                                  data-bs-toggle="tooltip" 
                                  title="{{ produit.messageStatutStock }}">
                                <i class="bi {{ produit.iconeStatutStock }}"></i>
                            </span>
                            {% if produit.expireBientot(30) %}
                                <span class="badge bg-danger mt-1" 
                                      data-bs-toggle="tooltip" 
                                      title="Expire dans {{ produit.joursAvantExpiration }} jours">
                                    <i class="bi bi-clock"></i>
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="fw-bold text-dark">{{ produit.nomProduit }}</div>
                            {% if not produit.actif %}
                                <span class="badge bg-secondary">Inactif</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="font-monospace text-muted">{{ produit.codeCip ?? 'N/A' }}</span>
                        </td>
                        <td class="text-muted">{{ produit.dosageProduit }}</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                    {% set pourcentageStock = min(100, (produit.stockActuel / produit.stockAlerte) * 100) %}
                                    <div class="progress-bar bg-{{ produit.couleurStatutStock }}" 
                                         style="width: {{ pourcentageStock }}%">
                                    </div>
                                </div>
                                <span class="fw-bold fs-6">{{ produit.stockActuel }}</span>
                            </div>
                            <small class="text-muted" style="font-size: 0.75rem;">
                                Critique: {{ produit.stockMinimum }} | Alerte: {{ produit.stockAlerte }}
                            </small>
                        </td>
                        <td class="text-end">
                            <div class="fw-bold">{{ produit.prixProduit|number_format(2, ',', ' ') }} €</div>
                            {% if produit.prixAchat %}
                                <small class="text-success" style="font-size: 0.75rem;" data-bs-toggle="tooltip" title="Marge: {{ produit.marge }}€">
                                    {{ produit.tauxMarge }}% marge
                                </small>
                            {% endif %}
                        </td>
                        <td>
                            <span class="{% if produit.expireBientot(30) %}text-danger fw-bold{% else %}text-muted{% endif %}">
                                {{ produit.dateExpiration|date('d/m/Y') }}
                            </span>
                        </td>
                        <td class="text-center pe-4">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_produit_show', {'idProduit': produit.id}) }}">
                                            <i class="bi bi-eye text-primary me-2"></i> Voir les détails
                                        </a>
                                    </li>
                                    {% if is_granted('ROLE_GESTIONNAIRE_STOCK') %}
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_produit_edit', {'idProduit': produit.id}) }}">
                                            <i class="bi bi-pencil text-warning me-2"></i> Modifier
                                        </a>
                                    </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="px-4 pb-3">
            {{ include('partials/_pagination.html.twig', { items: produits }) }}
        </div>
        {% else %}
        <div class="text-center py-5">
            <i class="bi bi-box-seam display-1 text-muted opacity-25"></i>
            <h4 class="text-muted mt-3">Aucun produit enregistré</h4>
            <p class="text-muted mb-4">Commencez par ajouter votre premier produit pour gérer votre stock.</p>
            {% if is_granted('ROLE_GESTIONNAIRE_STOCK') %}
            <a href="{{ path('app_produit_new') }}" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Ajouter un Produit
            </a>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});
</script>
{% endblock %}