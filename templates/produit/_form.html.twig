{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row g-4">
    <!-- Colonne Principale -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-box-seam text-primary me-2"></i> Informations générales
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.nom_produit, {'attr': {'class': 'form-control form-control-lg fw-bold text-dark', 'placeholder': 'Nom commercial du produit'}}) }}
                            {{ form_label(form.nom_produit, 'Nom commercial du produit *') }}
                            {{ form_errors(form.nom_produit) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.code_produit, {'attr': {'class': 'form-control font-monospace', 'placeholder': 'Code Interne'}}) }}
                            {{ form_label(form.code_produit, 'Code Interne (SKU) *') }}
                            {{ form_errors(form.code_produit) }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.code_cip, {'attr': {'class': 'form-control font-monospace', 'placeholder': 'Code CIP'}}) }}
                            {{ form_label(form.code_cip, 'Code CIP (Code-barres)') }}
                            {{ form_errors(form.code_cip) }}
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.dosage_produit, {'attr': {'class': 'form-control', 'placeholder': 'Dosage'}}) }}
                            {{ form_label(form.dosage_produit, 'Dosage (ex: 500mg, 10ml) *') }}
                            {{ form_errors(form.dosage_produit) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-calendar3 text-primary me-2"></i> Cycle de vie
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.date_fabrication, {'attr': {'class': 'form-control', 'placeholder': 'Date'}}) }}
                            {{ form_label(form.date_fabrication, 'Date de fabrication *') }}
                            {{ form_errors(form.date_fabrication) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.date_expiration, {'attr': {'class': 'form-control', 'placeholder': 'Date'}}) }}
                            {{ form_label(form.date_expiration, "Date d'expiration *") }}
                            {{ form_errors(form.date_expiration) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Colonne Latérale -->
    <div class="col-lg-4">
        <!-- Section Tarification -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-tag text-primary me-2"></i> Tarification
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="form-floating mb-3">
                    {{ form_widget(form.prix_achat, {'attr': {'class': 'form-control', 'placeholder': 'Prix achat'}}) }}
                    {{ form_label(form.prix_achat, "Prix d'achat HT (€)") }}
                    {{ form_errors(form.prix_achat) }}
                </div>
                
                <div class="form-floating mb-3">
                    {{ form_widget(form.prix_produit, {'attr': {'class': 'form-control fs-5 fw-bold text-success', 'placeholder': 'Prix vente'}}) }}
                    {{ form_label(form.prix_produit, 'Prix de vente TTC (€) *') }}
                    {{ form_errors(form.prix_produit) }}
                </div>
            </div>
        </div>

        <!-- Section Stock -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-boxes text-primary me-2"></i> Gestion des Stocks
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="form-floating mb-3">
                    {{ form_widget(form.stock_actuel, {'attr': {'class': 'form-control', 'placeholder': 'Stock initial'}}) }}
                    {{ form_label(form.stock_actuel, 'Stock actuel *') }}
                    {{ form_errors(form.stock_actuel) }}
                </div>
                <div class="form-floating mb-3">
                    {{ form_widget(form.stock_alerte, {'attr': {'class': 'form-control border-warning', 'placeholder': 'Seuil alerte'}}) }}
                    {{ form_label(form.stock_alerte, "Seuil d'alerte *") }}
                    {{ form_errors(form.stock_alerte) }}
                </div>
                <div class="form-floating mb-3">
                    {{ form_widget(form.stock_minimum, {'attr': {'class': 'form-control border-danger', 'placeholder': 'Seuil critique'}}) }}
                    {{ form_label(form.stock_minimum, 'Seuil critique (Rupture) *') }}
                    {{ form_errors(form.stock_minimum) }}
                </div>
                
                <hr class="my-4">
                
                <div class="form-check form-switch fs-5">
                    {{ form_widget(form.actif, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(form.actif, 'Produit disponible à la vente', {'label_attr': {'class': 'form-check-label text-dark'}}) }}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
    <a href="{{ path('app_produit_index') }}" class="btn btn-light text-muted fw-bold px-4 py-2">
        Annuler
    </a>
    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 shadow-sm">
        {{ button_label|default('Enregistrer le Produit') }}
    </button>
</div>

{{ form_end(form) }}

<style>
/* Surcharge locale pour les floating labels avec validation Symfony */
.form-floating > .form-control:focus ~ label,
.form-floating > .form-control:not(:placeholder-shown) ~ label {
    color: var(--color-primary);
    transform: scale(.85) translateY(-.5rem) translateX(.15rem);
}
.form-floating > .form-control {
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
}
.form-floating > .form-control:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.15);
}
</style>