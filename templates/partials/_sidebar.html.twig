{# templates/partials/_sidebar.html.twig #}
<style>
.sidebar-dropdown:hover .sidebar-submenu {
    display: block !important;
}
.sidebar-submenu {
    display: none;
    padding-left: 1.5rem;
}
.sidebar-submenu .nav-link {
    padding-top: 0.3rem;
    padding-bottom: 0.3rem;
    font-size: 0.9rem;
}
</style>
<nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block sidebar collapse" data-controller="sidebar">
    <div class="position-sticky pt-3 d-flex flex-column h-100">
        
        <div class="sidebar-brand">
            <i class="bi bi-capsule-pill text-primary me-2"></i>
            Jeffarma
        </div>

        {# ── DEFINITION DES ROLES POUR L'AFFICHAGE DES BADGES ── #}
        {% set isPharmacien   = is_granted('ROLE_PHARMACIEN') %}
        {% set isGestionnaire = is_granted('ROLE_GESTIONNAIRE_STOCK') and not isPharmacien %}
        {% set isCaissier     = is_granted('ROLE_CAISSIER') and not isPharmacien %}

        <div class="px-3 mb-3 d-flex flex-column gap-2">
            {% if isPharmacien %}
                <span class="badge w-100 py-2" style="background-color: #ef4444; font-size: 0.75rem;">
                    <i class="bi bi-star-fill me-1"></i> Pharmacien Titulaire
                </span>
            {% else %}
                {% if isGestionnaire %}
                    <span class="badge w-100 py-2" style="background-color: #f59e0b; font-size: 0.75rem;">
                        <i class="bi bi-box-seam me-1"></i> Logisticien
                    </span>
                {% endif %}
                {% if isCaissier %}
                    <span class="badge w-100 py-2" style="background-color: #10b981; font-size: 0.75rem;">
                        <i class="bi bi-calculator me-1"></i> Vendeur / Caissier
                    </span>
                {% endif %}
            {% endif %}
        </div>

        <ul class="nav flex-column mb-auto">
            {% if is_granted('ROLE_PHARMACIEN') %}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') == 'app_home' %}active{% endif %}"
                   href="{{ path('app_home') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-house-door me-2"></i> Tableau de Bord
                </a>
            </li>
            {% endif %}

            {% if is_granted('ROLE_CAISSIER') %}
            <li class="nav-item sidebar-dropdown">
                <a class="nav-link d-flex align-items-center {% if app.request.get('_route') starts with 'app_vente' %}active{% endif %}" href="#" style="cursor: default;">
                    <i class="bi bi-receipt me-2"></i> Ventes (POS)
                    <i class="bi bi-chevron-down ms-auto" style="font-size: 0.75rem;"></i>
                </a>
                <ul class="nav flex-column sidebar-submenu {% if app.request.get('_route') starts with 'app_vente' %}d-block{% endif %}">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_vente_new' %}active{% endif %}" href="{{ path('app_vente_new') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-plus-circle me-2"></i> Nouvelle Vente
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_vente_index' or app.request.get('_route') == 'app_vente_show' %}active{% endif %}" href="{{ path('app_vente_index') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-clock-history me-2"></i> Historique des ventes
                        </a>
                    </li>
                </ul>
            </li>
            {% endif %}

            {% if is_granted('ROLE_GESTIONNAIRE_STOCK') or is_granted('ROLE_CAISSIER') %}
            <li class="nav-item sidebar-dropdown">
                <a class="nav-link d-flex align-items-center {% if app.request.get('_route') starts with 'app_produit' %}active{% endif %}" href="#" style="cursor: default;">
                    <i class="bi bi-capsule me-2"></i> Catalogue Produits
                    <i class="bi bi-chevron-down ms-auto" style="font-size: 0.75rem;"></i>
                </a>
                <ul class="nav flex-column sidebar-submenu {% if app.request.get('_route') starts with 'app_produit' %}d-block{% endif %}">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_produit_index' or app.request.get('_route') == 'app_produit_show' %}active{% endif %}" href="{{ path('app_produit_index') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-card-list me-2"></i> Liste des produits
                        </a>
                    </li>
                    {% if is_granted('ROLE_GESTIONNAIRE_STOCK') %}
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_produit_new' %}active{% endif %}" href="{{ path('app_produit_new') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-plus-circle me-2"></i> Nouveau produit
                        </a>
                    </li>
                    {% endif %}
                </ul>
            </li>
            {% endif %}

            {% if is_granted('ROLE_GESTIONNAIRE_STOCK') %}
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_mouvement_stock' %}active{% endif %}"
                   href="{{ path('app_mouvement_stock_index') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-clock-history me-2"></i> Historique Stocks
                </a>
            </li>
            {% endif %}

            {% if is_granted('ROLE_CAISSIER') %}
            <li class="nav-item sidebar-dropdown">
                <a class="nav-link d-flex align-items-center {% if app.request.get('_route') starts with 'app_ordonnance' %}active{% endif %}" href="#" style="cursor: default;">
                    <i class="bi bi-file-text me-2"></i> Ordonnances
                    <i class="bi bi-chevron-down ms-auto" style="font-size: 0.75rem;"></i>
                </a>
                <ul class="nav flex-column sidebar-submenu {% if app.request.get('_route') starts with 'app_ordonnance' %}d-block{% endif %}">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_ordonnance_new' %}active{% endif %}" href="{{ path('app_ordonnance_new') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-plus-circle me-2"></i> Nouvelle ordonnance
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') == 'app_ordonnance_index' or app.request.get('_route') == 'app_ordonnance_show' %}active{% endif %}" href="{{ path('app_ordonnance_index') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-clock-history me-2"></i> Historique
                        </a>
                    </li>
                </ul>
            </li>
            
            <li class="nav-item sidebar-dropdown">
                <a class="nav-link d-flex align-items-center {% if app.request.get('_route') starts with 'app_patient' or app.request.get('_route') starts with 'app_mutuelle' or app.request.get('_route') starts with 'app_medecin' %}active{% endif %}" href="#" style="cursor: default;">
                    <i class="bi bi-gear me-2"></i> Paramètres
                    <i class="bi bi-chevron-down ms-auto" style="font-size: 0.75rem;"></i>
                </a>
                <ul class="nav flex-column sidebar-submenu {% if app.request.get('_route') starts with 'app_patient' or app.request.get('_route') starts with 'app_mutuelle' or app.request.get('_route') starts with 'app_medecin' %}d-block{% endif %}">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_patient' %}active{% endif %}" href="{{ path('app_patient_index') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-people me-2"></i> Patients
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_mutuelle' %}active{% endif %}" href="{{ path('app_mutuelle_index') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-shield-plus me-2"></i> Mutuelles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.get('_route') starts with 'app_medecin' %}active{% endif %}" href="{{ path('app_medecin_index') }}" data-action="click->sidebar#closeOnMobile">
                            <i class="bi bi-heart-pulse me-2"></i> Médecins
                        </a>
                    </li>
                </ul>
            </li>
            {% endif %}

            {% if is_granted('ROLE_GESTIONNAIRE_STOCK') %}
                {{ render(controller('App\\Controller\\StockController::alertWidget')) }}
            {% endif %}

            {% if is_granted('ROLE_PHARMACIEN') %}
            <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted text-uppercase" style="font-size: 0.65rem;">
                <span>Administration</span>
            </h6>
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_user' %}active{% endif %}"
                   href="{{ path('app_user_index') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-people-fill me-2 text-info"></i> Gestion Utilisateurs
                </a>
            </li>
            {% endif %}
        </ul>

        {# ── Utilisateur connecté + déconnexion ── #}
        {% if app.user %}
        <div class="mt-auto border-top border-secondary pt-3 px-3 pb-3">
            <div class="text-light small mb-2 text-truncate fw-bold">
                <i class="bi bi-person-circle me-1"></i>
                {{ app.user.prenom }} {{ app.user.nom }}
            </div>
            <a href="{{ path('app_logout') }}" class="nav-link text-danger small p-0 ms-1 mt-1">
                <i class="bi bi-box-arrow-left me-1"></i> Déconnexion
            </a>
        </div>
        {% endif %}

    </div>
</nav>

{# Overlay transparent pour fermer la sidebar sur mobile #}
<div id="sidebarBackdrop" class="sidebar-backdrop" data-action="click->sidebar#close"></div>
