{# templates/partials/_sidebar.html.twig #}
<nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block sidebar collapse" data-controller="sidebar">
    <div class="position-sticky pt-3 d-flex flex-column h-100">
        
        <div class="sidebar-brand">
            <i class="bi bi-capsule-pill text-primary me-2"></i>
            PharmaGest
        </div>

        {# ── Bouton action rapide ── #}
        <a href="{{ path('app_vente_new') }}" class="sidebar-quick-action mb-3">
            <i class="bi bi-plus-lg"></i> Nouvelle Vente
        </a>

        <ul class="nav flex-column mb-auto">
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') == 'app_home' %}active{% endif %}"
                   href="{{ path('app_home') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-house-door me-2"></i>
                    Tableau de Bord
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_vente' %}active{% endif %}"
                   href="{{ path('app_vente_index') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-receipt me-2"></i>
                    Ventes (POS)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_produit' %}active{% endif %}"
                   href="{{ path('app_produit_index') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-capsule me-2"></i>
                    Produits & Stock
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_ordonnance' %}active{% endif %}"
                   href="{{ path('app_ordonnance_index') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-file-text me-2"></i>
                    Ordonnances
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_patient' %}active{% endif %}"
                   href="{{ path('app_patient_index') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-people me-2"></i>
                    Patients
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_medecin' %}active{% endif %}"
                   href="{{ path('app_medecin_index') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-heart-pulse me-2"></i>
                    Médecins
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_mutuelle' %}active{% endif %}"
                   href="{{ path('app_mutuelle_index') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-shield-plus me-2"></i>
                    Mutuelles
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {% if app.request.get('_route') starts with 'app_stock' %}active{% endif %}"
                   href="{{ path('app_stock_reapprovisionnement') }}"
                   data-action="click->sidebar#closeOnMobile">
                    <i class="bi bi-exclamation-triangle me-2 {% if app.request.get('_route') starts with 'app_stock' %}text-white{% else %}text-warning{% endif %}"></i>
                    Alertes Stock
                </a>
            </li>
        </ul>

        {# ── Utilisateur connecté + déconnexion ── #}
        {% if app.user %}
        <div class="mt-auto border-top border-secondary pt-3 px-3 pb-3">
            <div class="text-light small mb-2 text-truncate">
                <i class="bi bi-person-circle me-1"></i>
                {{ app.user.userIdentifier }}
            </div>
            <a href="{{ path('app_logout') }}" class="nav-link text-danger small p-0 ms-1 mt-1">
                <i class="bi bi-box-arrow-left me-1"></i> Déconnexion
            </a>
        </div>
        {% endif %}

    </div>
</nav>

{# Overlay transparent pour fermer la sidebar sur mobile #}
<div id="sidebarBackdrop" class="sidebar-backdrop" data-action="click->sidebar#close"></div>
