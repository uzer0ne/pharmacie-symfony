{# templates/partials/_toasts.html.twig #}
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% set icon = 'info-circle' %}
            {% set colorClass = 'primary' %}
            
            {% if label == 'success' %}
                {% set icon = 'check-circle' %}
                {% set colorClass = 'success' %}
            {% elseif label == 'danger' or label == 'error' %}
                {% set icon = 'exclamation-circle' %}
                {% set colorClass = 'danger' %}
            {% elseif label == 'warning' %}
                {% set icon = 'exclamation-triangle' %}
                {% set colorClass = 'warning' %}
            {% endif %}

            <div class="toast border-0 shadow-sm" role="alert" aria-live="assertive" aria-atomic="true" data-controller="toast">
                <div class="toast-header border-0 text-white bg-{{ colorClass }} rounded-top">
                    <i class="bi bi-{{ icon }} me-2"></i>
                    <strong class="me-auto text-capitalize">
                        {{ label == 'danger' ? 'Erreur' : (label == 'success' ? 'Succès' : label) }}
                    </strong>
                    <small>à l'instant</small>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
                <div class="toast-body bg-white rounded-bottom">
                    {{ message }}
                </div>
            </div>
        {% endfor %}
    {% endfor %}
</div>
