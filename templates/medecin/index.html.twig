{% extends 'base.html.twig' %}

{% block title %}Médecins - PharmaGest{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-heart-pulse text-primary me-2"></i> Annuaire des Médecins
        </h1>
        <p class="page-subtitle mb-0">Gérez les professionnels de santé prescripteurs</p>
    </div>
    <div>
        <a href="{{ path('app_medecin_new') }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nouveau Médecin
        </a>
    </div>
</div>

<!-- Tableau des médecins -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        {% if medecins|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 border-0">N° RPPS</th>
                        <th class="border-0">Médecin</th>
                        <th class="border-0">Contact</th>
                        <th class="border-0">Cabinet</th>
                        <th class="border-0 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for medecin in medecins %}
                    <tr>
                        <td class="ps-4 text-muted">#{{ medecin.id }}</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-person-badge fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Dr. {{ medecin.prenomMedecin }} {{ medecin.nomMedecin }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if medecin.contactMedecin %}
                                <div class="text-dark"><i class="bi bi-telephone text-muted me-2"></i>{{ medecin.contactMedecin }}</div>
                            {% else %}
                                <span class="text-muted fst-italic">Non renseigné</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if medecin.adresseMedecin %}
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>{{ medecin.adresseMedecin|length > 40 ? medecin.adresseMedecin|slice(0, 40) ~ '...' : medecin.adresseMedecin }}</small>
                            {% else %}
                                <span class="text-muted fst-italic">Non renseigné</span>
                            {% endif %}
                        </td>
                        <td class="text-center pe-4">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_medecin_show', {'idMedecin': medecin.id}) }}">
                                            <i class="bi bi-eye text-primary me-2"></i> Voir la fiche
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_medecin_edit', {'idMedecin': medecin.id}) }}">
                                            <i class="bi bi-pencil text-warning me-2"></i> Modifier
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="px-4 pb-3">
            {{ include('partials/_pagination.html.twig', { items: medecins }) }}
        </div>
        {% else %}
        {{ include('partials/_empty_state.html.twig', {
            icon: 'heart-pulse',
            title: 'Aucun médecin enregistré',
            subtitle: 'Ajoutez les médecins prescripteurs pour lier leurs ordonnances aux patients.',
            action: { label: 'Ajouter un Médecin', path: 'app_medecin_new', icon: 'person-plus' }
        }) }}
        {% endif %}
    </div>
</div>
{% endblock %}
