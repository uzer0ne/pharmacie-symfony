{% extends 'base.html.twig' %}

{% block title %}Réapprovisionnement - PharmaGest{% endblock %}

{% block body %}
<!-- NAVIGATION (Visible uniquement à l'écran) -->
<div class="d-print-none">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 page-title text-danger">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Alertes de Stock
            </h1>
            <p class="page-subtitle mb-0">Liste des produits à commander d'urgence.</p>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-primary shadow-sm fw-bold">
                <i class="bi bi-printer me-2"></i> Imprimer le Bon de Commande
            </button>
        </div>
    </div>
</div>

<!-- ZONE D'IMPRESSION -->
<div id="section-a-imprimer">
    
    <!-- En-tête spécifique pour l'impression (Caché à l'écran) -->
    <div class="d-none d-print-block mb-4">
        <div class="row border-bottom pb-4 mb-4 align-items-end">
            <div class="col-6">
                <h2 class="fw-bold text-uppercase mb-2 text-dark" style="letter-spacing: 1px;">PharmaGest</h2>
                <p class="small text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>123 Rue de la Santé, 75000 Paris</p>
                <p class="small text-muted mb-0"><i class="bi bi-telephone me-1"></i>01 23 45 67 89</p>
            </div>
            <div class="col-6 text-end">
                <h3 class="fw-bold mb-2 text-primary border-bottom d-inline-block pb-2">BON DE COMMANDE</h3>
                <p class="mb-1 fw-medium text-dark">Date : {{ "now"|date("d/m/Y") }}</p>
                <p class="small text-muted mb-0 font-monospace">Réf : CMD-{{ "now"|date("Ymd") }}</p>
            </div>
        </div>
    </div>

    <!-- Le Tableau -->
    <div class="card shadow-sm border-0 border-top border-danger border-4 print-no-border">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-4 d-print-none border-bottom">
            <h5 class="mb-0 text-dark fw-bold">
                <i class="bi bi-cart-check text-primary me-2"></i> Proposition de Commande
            </h5>
            <span class="badge bg-light text-muted border border-secondary border-opacity-25 rounded-pill px-3 py-2">
                <i class="bi bi-robot me-1"></i> Généré automatiquement
            </span>
        </div>
        
        <div class="card-body p-0">
            {% if produits|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-bordered-print">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 border-0" style="width: 15%">Code / Réf</th>
                            <th class="border-0" style="width: 35%">Désignation Produit</th>
                            <th class="text-center border-0" style="width: 10%">Stock</th>
                            <th class="text-center border-0" style="width: 10%">Seuil</th>
                            <th class="text-center fw-bold table-active border-0" style="width: 15%">QTÉ À COMMANDER</th>
                            <th class="text-end pe-4 border-0 d-print-none">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for produit in produits %}
                            {# Formule de calcul : Remonter au seuil d'alerte + 50% #}
                            {% set suggestion = ((produit.stockAlerte * 1.5) - produit.stockActuel)|round(0, 'ceil') %}
                            
                            <tr>
                                <td class="ps-4">
                                    <span class="font-monospace text-muted small bg-light px-2 py-1 rounded border">{{ produit.codeProduit }}</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">{{ produit.nomProduit }}</div>
                                    <small class="text-muted d-block mt-1">{{ produit.dosageProduit }}</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 fs-6 px-3 py-2 rounded-pill">
                                        {{ produit.stockActuel }}
                                    </span>
                                </td>
                                <td class="text-center text-muted fw-medium">
                                    {{ produit.stockMinimum }}
                                </td>
                                <td class="text-center">
                                    <div class="bg-primary bg-opacity-10 text-primary fw-bold fs-5 px-3 py-2 rounded border border-primary border-opacity-25 d-inline-block" style="min-width: 60px;">
                                        {{ suggestion > 0 ? suggestion : '5' }}
                                    </div>
                                </td>
                                <td class="text-end pe-4 d-print-none">
                                    <a href="{{ path('app_produit_edit', {'idProduit': produit.id}) }}" class="btn btn-sm btn-outline-warning shadow-sm" title="Modifier le produit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <div class="text-center py-5 d-print-none">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                        <i class="bi bi-check-lg fs-1"></i>
                    </div>
                    <h4 class="text-dark fw-bold">Stock Optimal</h4>
                    <p class="text-muted fs-5">Aucun produit ne nécessite de réapprovisionnement pour le moment.</p>
                    <a href="{{ path('app_produit_index') }}" class="btn btn-outline-primary mt-3">
                        Voir le catalogue
                    </a>
                </div>
                <div class="d-none d-print-block text-center py-5">
                    <h3>Aucune commande nécessaire ce jour.</h3>
                </div>
            {% endif %}
        </div>
        
        <!-- Pied de page du tableau (Signature) -->
        <div class="d-none d-print-block mt-5 pt-5 pb-5">
            <div class="row">
                <div class="col-7"></div>
                <div class="col-5 text-center">
                    <div class="border-top border-dark border-2 pt-3 mt-4">
                        <p class="fw-bold text-uppercase mb-5 pb-5">Signature et Cachet du Pharmacien</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* CSS SPÉCIFIQUE POUR L'IMPRESSION */
@media print {
    body { background-color: #fff !important; }
    body * { visibility: hidden; }

    #section-a-imprimer, #section-a-imprimer * { visibility: visible; }
    
    #section-a-imprimer {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .d-print-none { display: none !important; }
    .d-print-block { display: block !important; }
    
    .card, .shadow-sm { 
        box-shadow: none !important; 
        border: none !important; 
    }
    
    /* On force des bordures nettes pour l'impression du tableau */
    .table-bordered-print { border-collapse: collapse !important; width: 100% !important; }
    .table-bordered-print th, .table-bordered-print td {
        border: 1px solid #475569 !important;
        padding: 12px !important;
    }
    .table-bordered-print th {
        background-color: #f8fafc !important;
        color: #0f172a !important;
    }
    
    /* On force les couleurs de fond (ex: cellules grisées) */
    * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
}
</style>
{% endblock %}