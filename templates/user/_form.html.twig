{{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

<div class="row g-3">
    <!-- Identité & Connexion -->
    <div class="col-md-12">
        <h5 class="mb-2 text-dark fw-bold border-bottom pb-2">
            <i class="bi bi-person-badge text-primary me-2"></i> Identité & Connexion
        </h5>
    </div>

    <div class="col-md-3">
        <div class="form-floating">
            {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
            <label for="{{ form.prenom.vars.id }}">Prénom</label>
            {{ form_errors(form.prenom) }}
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="form-floating">
            {{ form_widget(form.nom, {'attr': {'class': 'form-control fw-bold text-dark', 'placeholder': 'Nom'}}) }}
            <label for="{{ form.nom.vars.id }}">Nom de famille</label>
            {{ form_errors(form.nom) }}
        </div>
    </div>

    <div class="col-md-3">
        <div class="form-floating">
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Email'}}) }}
            <label for="{{ form.email.vars.id }}">Adresse email</label>
            {{ form_errors(form.email) }}
        </div>
    </div>

    <div class="col-md-3">
        <div class="form-floating">
            {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
            <label for="{{ form.plainPassword.vars.id }}">Mot de passe</label>
            {{ form_errors(form.plainPassword) }}
        </div>
        {% if form.vars.value.id %}
            <small class="text-warning d-block mt-1" style="font-size: 0.7rem;"><i class="bi bi-info-circle"></i> Vide = inchangé</small>
        {% else %}
            <small class="text-muted d-block mt-1" style="font-size: 0.7rem;"><i class="bi bi-info-circle"></i> Par défaut : password123</small>
        {% endif %}
    </div>

    <!-- Paramètres Planning & RH -->
    <div class="col-md-12 mt-4">
        <h5 class="mb-2 text-dark fw-bold border-bottom pb-2">
            <i class="bi bi-calendar-week text-primary me-2"></i> Paramètres Planning & RH
        </h5>
    </div>

    <div class="col-md-4">
        <div class="form-floating">
            {{ form_widget(form.qualification, {'attr': {'class': 'form-select'}}) }}
            <label for="{{ form.qualification.vars.id }}">Qualification</label>
            {{ form_errors(form.qualification) }}
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="form-floating">
            {{ form_widget(form.tempsTravailHebdo, {'attr': {'class': 'form-control', 'placeholder': '35'}}) }}
            <label for="{{ form.tempsTravailHebdo.vars.id }}">Heures/semaine</label>
            {{ form_errors(form.tempsTravailHebdo) }}
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="form-floating">
            {{ form_widget(form.numeroRpps, {'attr': {'class': 'form-control', 'placeholder': 'RPPS'}}) }}
            <label for="{{ form.numeroRpps.vars.id }}">Numéro RPPS (Pharmaciens)</label>
            {{ form_errors(form.numeroRpps) }}
        </div>
    </div>

    <!-- Droits et Sécurité -->
    <div class="col-md-12 mt-4">
        <h5 class="mb-3 text-dark fw-bold border-bottom pb-2">
            <i class="bi bi-shield-lock text-primary me-2"></i> Rôles d'accès au logiciel
        </h5>
    </div>

    <div class="col-md-12">
        <div class="row g-3">
            {% for child in form.roles %}
                <div class="col-md-4">
                    <label class="card h-100 shadow-sm border-secondary role-card" style="cursor: pointer; transition: 0.2s;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-start mb-2">
                                <div class="me-2 mt-1">
                                    {{ form_widget(child, {'attr': {'class': 'form-check-input fs-5 role-checkbox'}}) }}
                                </div>
                                <h6 class="mb-0 fw-bold text-dark lh-sm">{{ child.vars.label }}</h6>
                            </div>
                            <p class="mb-0 text-muted" style="font-size: 0.75rem; line-height: 1.3;">
                                {% if child.vars.value == 'ROLE_PHARMACIEN' %}
                                    <i class="bi bi-star-fill text-warning me-1"></i> Patron. Tous les droits, accès au Tableau de bord et gestion des employés. Peut tout supprimer.
                                {% elseif child.vars.value == 'ROLE_GESTIONNAIRE_STOCK' %}
                                    <i class="bi bi-box-seam text-info me-1"></i> Arrière-boutique. Gestion complète du catalogue et des stocks. Bloqué à la caisse et ordonnances.
                                {% elseif child.vars.value == 'ROLE_CAISSIER' %}
                                    <i class="bi bi-cart text-success me-1"></i> Comptoir. Ventes, patients, mutuelles. Lecture seule sur le catalogue. Aucune suppression.
                                {% endif %}
                            </p>
                        </div>
                    </label>
                </div>
            {% endfor %}
        </div>
        {{ form_errors(form.roles) }}
    </div>
</div>

<div class="mt-4 pt-3 border-top text-end">
    <button class="btn btn-primary px-5 py-2 shadow-sm rounded-pill fw-bold">
        <i class="bi bi-check-circle me-2"></i> {{ button_label|default('Enregistrer') }}
    </button>
</div>
{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('.role-checkbox');
    let pharmacienCheckbox = null;
    let otherCheckboxes = [];

    checkboxes.forEach(cb => {
        if (cb.value === 'ROLE_PHARMACIEN') {
            pharmacienCheckbox = cb;
        } else {
            otherCheckboxes.push(cb);
        }
    });

    if (pharmacienCheckbox) {
        function updateRolesLogic() {
            if (pharmacienCheckbox.checked) {
                otherCheckboxes.forEach(cb => {
                    cb.checked = false;
                    cb.disabled = true;
                    const parentCard = cb.closest('.role-card');
                    if(parentCard) parentCard.style.opacity = '0.5';
                });
            } else {
                otherCheckboxes.forEach(cb => {
                    cb.disabled = false;
                    const parentCard = cb.closest('.role-card');
                    if(parentCard) parentCard.style.opacity = '1';
                });
            }
        }
        pharmacienCheckbox.addEventListener('change', updateRolesLogic);
        updateRolesLogic();
    }
});
</script>
