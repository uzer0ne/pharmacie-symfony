{% extends 'base.html.twig' %}

{% block title %}Détail Vente n°{{ vente.id }} - PharmaGest{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-receipt-cutoff text-success me-2"></i> Reçu de Vente n°{{ vente.id }}
        </h1>
        <p class="page-subtitle mb-0">Transaction du {{ vente.dateVente|date('d/m/Y à H:i') }}</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_vente_index') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
        <button onclick="window.print()" class="btn btn-light border shadow-sm text-dark">
            <i class="bi bi-printer me-1"></i> Imprimer
        </button>
        <a href="{{ path('app_vente_edit', {'id': vente.id}) }}" class="btn btn-warning shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<!-- Reçu de vente -->
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0" id="recu-vente">
            <div class="card-header bg-white border-bottom py-4 px-5">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0 text-dark fw-bold"><i class="bi bi-shop text-primary me-2"></i> PharmaGest</h4>
                        <p class="text-muted mb-0 small mt-1">Reçu n°{{ vente.id }}</p>
                    </div>
                    <div class="text-end text-muted">
                        <p class="mb-0"><i class="bi bi-calendar3 me-1"></i> {{ vente.dateVente|date('d/m/Y H:i') }}</p>
                        <p class="mb-0 mt-1"><i class="bi bi-person me-1"></i> 
                            {% if vente.patient %}
                                {{ vente.patient.prenomPatient }} {{ vente.patient.nomPatient }}
                            {% else %}
                                Vente libre
                            {% endif %}
                        </p>
                    </div>
                </div>
            </div>

            <div class="card-body p-5">
                {% if vente.ordonnance %}
                    <div class="alert bg-primary bg-opacity-10 border-0 text-primary mb-4">
                        <i class="bi bi-file-medical-fill me-2"></i> <strong>Ordonnance rattachée :</strong> n°{{ vente.ordonnance.id }} (Prescrite le {{ vente.ordonnance.dateOrdonnance|date('d/m/Y') }})
                    </div>
                {% endif %}

                <h5 class="text-dark fw-bold mb-4 border-bottom pb-2">Produits vendus</h5>
                <div class="table-responsive">
                    <table class="table table-borderless align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 border-0 rounded-start">Désignation</th>
                                <th class="border-0 text-end">P.U TTC</th>
                                <th class="border-0 text-center">Qté</th>
                                <th class="border-0 text-end rounded-end pe-3">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ligne in vente.ligneVentes %}
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">{{ ligne.produit.nomProduit }}</div>
                                        <small class="text-muted font-monospace">{{ ligne.produit.codeProduit }}</small>
                                    </td>
                                    <td class="text-end">{{ ligne.prixUnitaireVente|number_format(2, ',', ' ') }} €</td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1">{{ ligne.quantite }}</span>
                                    </td>
                                    <td class="text-end fw-bold pe-3">{{ (ligne.prixUnitaireVente * ligne.quantite)|number_format(2, ',', ' ') }} €</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-danger py-4">
                                        <i class="bi bi-exclamation-triangle"></i> Cette vente ne contient aucun produit.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <hr class="my-4">

                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <div class="d-flex justify-content-between align-items-center bg-light rounded p-4 border border-success border-opacity-25">
                            <h5 class="mb-0 text-muted">Total Net TTC</h5>
                            <h2 class="mb-0 text-success fw-bold">{{ vente.montantTotal|number_format(2, ',', ' ') }} €</h2>
                        </div>
                    </div>
                </div>
                
                <div class="text-center text-muted mt-5 pt-4 border-top d-print-block">
                    <p class="small mb-0">Merci de votre confiance. Gardez ce reçu comme preuve d'achat.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@media print {
    body { background-color: white !important; }
    .card { box-shadow: none !important; border: 1px solid #dee2e6 !important; }
}
</style>
{% endblock %}