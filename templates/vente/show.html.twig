{% extends 'base.html.twig' %}

{% block title %}Facture n°{{ vente.id }} - Jeffarma{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-receipt-cutoff text-success me-2"></i> Facture n°{{ vente.id }}
        </h1>
        <p class="page-subtitle mb-0">Transaction du {{ vente.dateVente|date('d/m/Y') }}</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_vente_index') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
        <button onclick="window.print()" class="btn btn-light border shadow-sm text-dark fw-bold">
            <i class="bi bi-printer me-1"></i> Imprimer le Ticket
        </button>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5 col-xl-4">
        <!-- TICKET DE CAISSE -->
        <div class="ticket-container bg-white shadow p-4 mx-auto mb-5" id="recu-vente">
            
            <div class="ticket-header text-center mb-1">
                <div>PHARMACIE JEFFARMA</div>
                <div>TEL : 01 23 45 67 89 &nbsp; OP : {{ app.user ? app.user.userIdentifier : 'Système' }}</div>
                {% if vente.ordonnance and vente.ordonnance.medecin %}
                    <div class="mt-1">ID {{ vente.ordonnance.medecin.id }} RPPS {{ vente.ordonnance.medecin.numeroRpps ?? '00000000000' }}</div>
                    <div>Dr. {{ vente.ordonnance.medecin.nomMedecin|upper }}</div>
                {% endif %}
            </div>

            <div class="ticket-meta mb-1 border-bottom border-dark border-1 pb-1 border-dashed">
                <div>021 reg.1 FACTURE No.{{ "%09d"|format(vente.id) }}</div>
                <div>{{ vente.dateVente|date('d/m/y H:i') }}{% if vente.ordonnance %}, ord. {{ vente.ordonnance.dateOrdonnance|date('d/m/y') }}{% endif %}</div>
                {% if vente.patient %}
                    <div class="mt-1 text-uppercase">{{ vente.patient.nomPatient }} {{ vente.patient.prenomPatient }}</div>
                    <div>CV TP + 0{{ vente.patient.dateNaissance|date('y') }}{{ vente.patient.dateNaissance|date('m') }}9999{{ vente.patient.idPatient }}</div>
                {% endif %}
            </div>

            <table class="table table-borderless table-sm ticket-table mb-1" style="table-layout: fixed; width: 100%; font-size: 0.6rem;">
                <thead>
                    <tr class="border-bottom border-dark border-1 border-dashed" style="font-weight: normal;">
                        <th class="ps-0 pb-1" style="width: 5%; font-weight: normal;">Qté</th>
                        <th class="pb-1" style="width: 32%; padding-left: 2px; font-weight: normal;">Libellé</th>
                        <th class="text-center pb-1" style="width: 22%; font-weight: normal;">Identifiant</th>
                        <th class="text-end pb-1" style="width: 12%; font-weight: normal;">PU</th>
                        <th class="text-end pb-1" style="width: 20%; padding-right: 5px; font-weight: normal;">BaseSS HD</th>
                        <th class="text-end pe-0 pb-1" style="width: 9%; font-weight: normal;">TxR</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ligne in vente.ligneVentes %}
                        {% set isRemboursable = ligne.produit.codeCip is not empty %}
                        {% set baseSS = isRemboursable ? ligne.prixUnitaireVente : '-' %}
                        {% set txR = ligne.tauxRemboursement ? ligne.tauxRemboursement|replace({' ': ''}) : (isRemboursable ? '65%' : '-') %}
                        
                        <tr>
                            <td class="ps-0 align-top">{{ ligne.quantite }}</td>
                            <td class="align-top" style="padding-left: 2px;">
                                {% set parts = ligne.produit.nomProduit|split(',') %}
                                {% set baseName = parts|first|lower|capitalize|replace({' mg': 'mg', ' g': 'g', ' ml': 'ml', ' µg': 'µg', ' ui': 'UI', ' u.i.': 'UI', ' m.': 'mg'}) %}
                                {% set shortForm = '' %}
                                {% if parts|length > 1 %}
                                    {% set formStr = parts|last|lower %}
                                    {% if 'comprimé' in formStr %}{% set shortForm = ' cpr' %}
                                    {% elseif 'gélule' in formStr or 'gelule' in formStr %}{% set shortForm = ' gel' %}
                                    {% elseif 'capsule' in formStr %}{% set shortForm = ' caps' %}
                                    {% elseif 'pommade' in formStr or 'crème' in formStr %}{% set shortForm = ' pomm' %}
                                    {% elseif 'sirop' in formStr %}{% set shortForm = ' srp' %}
                                    {% elseif 'sachet' in formStr %}{% set shortForm = ' sch' %}
                                    {% elseif 'ampoule' in formStr %}{% set shortForm = ' amp' %}
                                    {% elseif 'solution' in formStr or 'gouttes' in formStr %}{% set shortForm = ' sol' %}
                                    {% endif %}
                                {% endif %}
                                <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; line-height: 1.15;">
                                    {{ baseName }}{{ shortForm }}
                                </div>
                                {% if ligne.produit.codeProduit %}
                                <div class="text-muted" style="font-size: 0.9em;">({{ ligne.produit.codeProduit }})</div>
                                {% endif %}
                            </td>
                            <td class="text-center align-top">{{ ligne.produit.codeCip ?? '-' }}</td>
                            <td class="text-end align-top" style="padding-right: 5px;">{{ ligne.prixUnitaireVente|number_format(2, ',', '') }}</td>
                            <td class="text-end align-top" style="white-space: nowrap; padding-right: 5px;">
                                {% if isRemboursable and vente.ordonnance %}
                                    {{ baseSS|number_format(2, ',', '') }} &nbsp; 1,02
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="text-end pe-0 align-top" style="white-space: nowrap;">
                                {% if vente.ordonnance %}
                                    {{ txR }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    <!-- Autres honoraires (HDR, HDA, etc.) -->
                    {% if vente.detailsHonoraires %}
                        {% for honoraire in vente.detailsHonoraires %}
                            {% if honoraire.libelle != 'HONORAIRE DE DISPENSATION' %}
                            <tr>
                                <td class="ps-0 align-top">{{ honoraire.qte }}</td>
                                <td class="align-top" style="padding-left: 2px;">
                                    <div style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; line-height: 1.15;">
                                        {{ honoraire.libelle|lower|capitalize }}
                                    </div>
                                </td>
                                <td class="text-center align-top">-</td>
                                <td class="text-end align-top">-</td>
                                <td class="text-end align-top" style="padding-right: 5px;">{{ (honoraire.montant / honoraire.qte)|number_format(2, ',', '') }}</td>
                                <td class="text-end pe-0 align-top" style="white-space: nowrap;">{{ honoraire.txR|replace({' ': ''}) }}</td>
                            </tr>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>

            <div class="ticket-totals border-top border-dark border-1 pt-1 border-dashed mt-1">
                <div class="row g-0">
                    <div class="col-6">MONTANT TOTAL :</div>
                    <div class="col-6 text-end">{{ vente.montantTotal|number_format(2, ',', '') }} EUR</div>
                </div>
                
                <div class="row g-0 mt-1">
                    <div class="col-6">MONTANT ASSURE :</div>
                    <div class="col-6 text-end">{{ vente.resteAPayer|number_format(2, ',', '') }} EUR</div>
                    
                    {% if vente.ordonnance %}
                    <div class="col-6">MONTANT RO :</div>
                    <div class="col-6 text-end">{{ vente.montantSecu|number_format(2, ',', '') }} EUR</div>
                    
                    <div class="col-6">MONTANT RC :</div>
                    <div class="col-6 text-end">{{ vente.montantMutuelle|number_format(2, ',', '') }} EUR</div>
                    {% endif %}
                </div>
            </div>

            
            
        </div>
    </div>
</div>

<style>
/* Style d'écran pour ressembler à un ticket */
.ticket-container {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.65rem;
    color: #000;
    line-height: 1.3;
    background-color: #fdfdfd;
    max-width: 420px; /* Élargi pour être bien lisible sur PC */
    margin: 0 auto;
}

.border-dashed {
    border-style: dashed !important;
}

.ticket-table th, .ticket-table td {
    padding: 0.1rem 0;
}

.text-truncate-multiline {
    /* Suppression du truncate strict pour éviter les chevauchements bizarres */
    word-break: break-word;
}

/* Style spécifique pour l'impression (Imprimante thermique) */
@media print {
    @page {
        margin: 0;
        size: 80mm auto; /* Forcé à 80mm pour l'imprimante thermique */
    }
    body * {
        visibility: hidden;
    }
    body {
        background-color: white !important;
        margin: 0;
        padding: 0;
    }
    .ticket-container {
        font-size: 0.65rem !important; /* Même taille qu'à l'écran */
        max-width: 80mm;
        padding: 5mm !important;
    }
    #recu-vente, #recu-vente * {
        visibility: visible;
    }
    #recu-vente {
        position: absolute;
        left: 0;
        top: 0;
        width: 80mm;
        margin: 0;
        box-shadow: none !important;
    }
}
</style>
{% endblock %}