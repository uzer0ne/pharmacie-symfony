                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <style>
                    @keyframes pos-pulse-ring { 0% { box-shadow: 0 0 0 0 rgba(var(--pulse-color), 0.7); } 70% { box-shadow: 0 0 0 8px rgba(var(--pulse-color), 0); } 100% { box-shadow: 0 0 0 0 rgba(var(--pulse-color), 0); } }
                    .pos-highlight-active { position: relative; z-index: 10; border: 2px solid rgb(var(--pulse-color)) !important; animation: pos-pulse-ring 1.5s infinite; }
                    .pos-highlight-active .pos-pin-icon { display: flex !important; }

                    /* THEMES */
                    .pos-theme-rx .pos-grid-cell, .pos-theme-otc .pos-grid-cell { 
                        background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%); 
                        border: 1px solid #ced4da; border-bottom: 2px solid #adb5bd; border-radius: 2px; 
                        box-shadow: inset 0 1px 0 rgba(255,255,255,1), 0 1px 1px rgba(0,0,0,0.05); 
                    }
                    .pos-theme-rx .pos-cell-label-slot, .pos-theme-otc .pos-cell-label-slot { position: absolute; top: 3px; left: 50%; transform: translateX(-50%); width: 60%; height: 5px; background-color: #e9ecef; border: 1px solid #dee2e6; border-radius: 1px; box-shadow: inset 0 1px 1px rgba(0,0,0,0.05); }
                    .pos-theme-rx .pos-cell-handle, .pos-theme-otc .pos-cell-handle { position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); width: 50%; height: 4px; background: linear-gradient(180deg, #e9ecef 0%, #ced4da 100%); border: 1px solid #adb5bd; border-bottom: 2px solid #868e96; border-radius: 1px; }

                    .pos-theme-para .pos-grid-cell, .pos-theme-mat .pos-grid-cell, .pos-theme-stock .pos-grid-cell {
                        background: #fdfbf7; border: none; border-bottom: 4px solid #d4c5b0; border-radius: 0; margin-bottom: 2px;
                    }
                    .pos-theme-para .pos-cell-label-slot, .pos-theme-para .pos-cell-handle, .pos-theme-mat .pos-cell-label-slot, .pos-theme-mat .pos-cell-handle, .pos-theme-stock .pos-cell-label-slot, .pos-theme-stock .pos-cell-handle { display: none; }

                    .pos-theme-fridge .pos-grid-cell {
                        background: rgba(224, 247, 250, 0.4); border: 1px solid rgba(0, 188, 212, 0.3); border-bottom: 3px solid rgba(0, 188, 212, 0.6); border-radius: 2px;
                    }
                    .pos-theme-fridge .pos-cell-label-slot, .pos-theme-fridge .pos-cell-handle { display: none; }
                    .pos-theme-fridge { background-color: #f0fbfe !important; border-color: #b2ebf2 !important; }

                    .pos-theme-safe .pos-grid-cell {
                        background: #495057; border: 1px solid #343a40; border-bottom: 3px solid #212529; color: white;
                    }
                    .pos-theme-safe .pos-cell-label-slot, .pos-theme-safe .pos-cell-handle { display: none; }
                    .pos-theme-safe { background-color: #e9ecef !important; border-color: #adb5bd !important; border-width: 3px !important; }
                </style>

                <!-- FORMULAIRE SYMFONY CACHÉ (C'est ce qui sera envoyé au serveur) -->
