<!-- Scripts et Styles TomSelect (CDN) -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<style>
/* Petits ajustements pour la carte d'identité du produit */
#produit-identity-card {
    transition: all 0.3s ease-in-out;
}
.ts-control {
    border-radius: 0.375rem;
}
.ts-dropdown .option {
    padding: 10px;
    border-bottom: 1px solid #f0f0f0;
}
.ts-dropdown .option .nom {
    font-weight: bold;
    color: #333;
}
.ts-dropdown .option .details {
    font-size: 0.85em;
    color: #666;
    margin-top: 4px;
}
.ts-dropdown .option .stock-badge {
    float: right;
    font-size: 0.8em;
    padding: 3px 6px;
    border-radius: 10px;
}

/* Alignement horizontal des champs ajoutés dynamiquement */
.dynamic-fields-wrapper > div {
    display: flex;
    gap: 15px;
    align-items: center;
    width: 100%;
}
.dynamic-fields-wrapper > div > div:nth-child(1) {
    flex: 3; /* Le produit prend plus de place */
    margin-bottom: 0 !important;
}
.dynamic-fields-wrapper > div > div:nth-child(2) {
    flex: 1; /* La quantité prend moins de place */
    margin-bottom: 0 !important;
}

/* ===== SMART LOCATOR GRID THEMES ===== */
@keyframes bounce-pin { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-25%); } }
.animate-bounce-pin { animation: bounce-pin 1s infinite ease-in-out; }
@keyframes pulse-ring { 0% { box-shadow: 0 0 0 0 rgba(var(--pulse-color), 0.7); } 70% { box-shadow: 0 0 0 10px rgba(var(--pulse-color), 0); } 100% { box-shadow: 0 0 0 0 rgba(var(--pulse-color), 0); } }
.pos-highlight-active { position: relative; z-index: 10; border: 3px solid rgb(var(--pulse-color)) !important; animation: pulse-ring 1.5s infinite; }

.pos-grid-cell { height: 35px !important; position: relative; transition: all 0.3s; }

/* THEME RX / OTC (Tiroirs) */
.pos-theme-rx .pos-grid-cell, .pos-theme-otc .pos-grid-cell { 
    background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%); 
    border: 1px solid #ced4da; border-bottom: 2px solid #adb5bd; border-radius: 3px; 
    box-shadow: inset 0 1px 0 rgba(255,255,255,1), 0 1px 2px rgba(0,0,0,0.05); 
}
.pos-theme-rx .pos-cell-label-slot, .pos-theme-otc .pos-cell-label-slot { position: absolute; top: 4px; left: 50%; transform: translateX(-50%); width: 50%; height: 6px; background-color: #e9ecef; border: 1px solid #dee2e6; border-radius: 1px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05); }
.pos-theme-rx .pos-cell-handle, .pos-theme-otc .pos-cell-handle { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); width: 40%; height: 4px; background: linear-gradient(180deg, #e9ecef 0%, #ced4da 100%); border: 1px solid #adb5bd; border-bottom: 2px solid #868e96; border-radius: 2px; box-shadow: 0 1px 1px rgba(0,0,0,0.1); }

/* THEME PARA / MAT / STOCK (Étagères bois/metal) */
.pos-theme-para .pos-grid-cell, .pos-theme-mat .pos-grid-cell, .pos-theme-stock .pos-grid-cell {
    background: #fdfbf7; border: none; border-bottom: 6px solid #d4c5b0; border-radius: 0; margin-bottom: 4px;
}
.pos-theme-para .pos-cell-label-slot, .pos-theme-para .pos-cell-handle, .pos-theme-mat .pos-cell-label-slot, .pos-theme-mat .pos-cell-handle, .pos-theme-stock .pos-cell-label-slot, .pos-theme-stock .pos-cell-handle { display: none; }

/* THEME FRIDGE */
.pos-theme-fridge .pos-grid-cell {
    background: rgba(224, 247, 250, 0.4); border: 1px solid rgba(0, 188, 212, 0.3); border-bottom: 4px solid rgba(0, 188, 212, 0.6); border-radius: 2px;
}
.pos-theme-fridge .pos-cell-label-slot, .pos-theme-fridge .pos-cell-handle { display: none; }
.pos-theme-fridge { background-color: #f0fbfe !important; border-color: #b2ebf2 !important; }

/* THEME SAFE */
.pos-theme-safe .pos-grid-cell {
    background: #495057; border: 2px solid #343a40; border-bottom: 4px solid #212529; color: white;
}
.pos-theme-safe .pos-cell-label-slot, .pos-theme-safe .pos-cell-handle { display: none; }
.pos-theme-safe { background-color: #e9ecef !important; border-color: #adb5bd !important; border-width: 4px !important; }

.pos-pin-icon { position: absolute; top: -15px; right: -15px; background: rgb(var(--pulse-color)); color: white; border-radius: 50%; width: 26px !important; height: 26px !important; display: none; align-items: center; justify-content: center; font-weight: bold; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); z-index: 20; }
.pos-highlight-active .pos-pin-icon { display: flex !important; }
</style>

{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row g-2">
    <!-- Section principale: POS & Scanner -->
    <div class="col-md-6 col-lg-7">
        <div class="card border-0 shadow-sm mb-2">
            <div class="card-header bg-white border-bottom pt-2 pb-2 px-3 d-flex justify-content-between align-items-center">
