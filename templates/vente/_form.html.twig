<!-- Scripts et Styles TomSelect (CDN) -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<style>
/* Petits ajustements pour la carte d'identité du produit */
#produit-identity-card {
    transition: all 0.3s ease-in-out;
}
.ts-control {
    border-radius: 0.375rem;
}
.ts-dropdown .option {
    padding: 10px;
    border-bottom: 1px solid #f0f0f0;
}
.ts-dropdown .option .nom {
    font-weight: bold;
    color: #333;
}
.ts-dropdown .option .details {
    font-size: 0.85em;
    color: #666;
    margin-top: 4px;
}
.ts-dropdown .option .stock-badge {
    float: right;
    font-size: 0.8em;
    padding: 3px 6px;
    border-radius: 10px;
}
</style>

{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row g-4">
    <!-- Section principale: POS & Scanner -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-cart text-primary me-2"></i> Produits du Panier
                </h5>
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-upc-scan text-muted"></i></span>
                    <input type="text" id="scanner-input" class="form-control border-start-0 bg-light" placeholder="Scanner CIP..." autocomplete="off">
                </div>
            </div>
            <div class="card-body p-4 bg-light bg-opacity-50">
                <div id="ligne-ventes-list" class="collection-ligne-ventes" data-index="{{ form.ligneVentes|length }}">
                    {% for ligneVenteForm in form.ligneVentes %}
                        <div class="ligne-vente-item bg-white p-3 mb-3 border rounded shadow-sm position-relative">
                            <div class="row align-items-center">
                                <div class="col-md-5">
                                    {{ form_row(ligneVenteForm.produit) }}
                                </div>
                                <div class="col-md-3">
                                    {{ form_row(ligneVenteForm.quantite) }}
                                </div>
                                <div class="col-md-3">
                                    {{ form_row(ligneVenteForm.prixUnitaireVente) }}
                                </div>
                                <div class="col-md-1 text-end">
                                    <button type="button" class="btn btn-outline-danger btn-sm border-0 remove-btn mt-3" title="Retirer">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="text-center mt-4">
                    <button type="button" class="btn btn-light fw-bold text-primary px-4 add-ligne-vente-btn border">
                        <i class="bi bi-plus-lg me-1"></i> Ajouter une ligne de produit
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Section latérale: Client & Résumé -->
    <div class="col-lg-4">
        <!-- Carte d'identité du produit (Affichée dynamiquement) -->
        <div class="card border-0 shadow-sm mb-4 d-none border-primary" id="produit-identity-card">
            <div class="card-header bg-primary text-white pt-3 pb-2 px-4">
                <h6 class="card-title mb-0 fw-bold">
                    <i class="bi bi-box-seam me-2"></i> Informations Produit
                </h6>
            </div>
            <div class="card-body p-4 bg-light">
                <h5 id="id-card-nom" class="fw-bold text-dark mb-1">Nom du produit</h5>
                <p id="id-card-famille" class="text-muted small mb-3 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Famille</p>
                
                <div class="row mb-3 g-2">
                    <div class="col-6">
                        <div class="p-2 bg-white rounded border text-center">
                            <small class="text-muted d-block" style="font-size:0.75rem">Dosage</small>
                            <strong id="id-card-dosage" class="text-dark">--</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-white rounded border text-center">
                            <small class="text-muted d-block" style="font-size:0.75rem">En stock</small>
                            <strong id="id-card-stock" class="text-primary fs-5">--</strong>
                        </div>
                    </div>
                </div>

                <p id="id-card-description" class="small text-secondary mb-0 border-top pt-3">
                    Description du produit...
                </p>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-person text-primary me-2"></i> Client & Ordonnance
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    {{ form_label(form.patient, 'Sélectionner un patient', {'label_attr': {'class': 'fw-medium mb-2'}}) }}
                    {{ form_widget(form.patient, {'attr': {'class': 'form-select form-select-lg'}}) }}
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Laissez vide pour une vente libre</small>
                </div>
                
                <div class="mb-2">
                    {{ form_label(form.ordonnance, 'Ordonnance rattachée', {'label_attr': {'class': 'fw-medium mb-2'}}) }}
                    {{ form_widget(form.ordonnance, {'attr': {'class': 'form-select'}}) }}
                </div>
            </div>
        </div>

        <div class="card bg-primary text-white border-0 shadow-sm">
            <div class="card-body p-4">
                <h6 class="text-white-50 text-uppercase fw-bold mb-3">Résumé de la commande</h6>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fs-5">Montant Total</span>
                    <span class="fs-2 fw-bold text-white">0,00 €</span>
                </div>
                
                {{ form_errors(form) }}
                {{ form_errors(form.ligneVentes) }}
                
                <button type="submit" class="btn btn-light w-100 py-3 fw-bold fs-5 text-primary">
                    <i class="bi bi-check-circle-fill me-2"></i> {{ button_label|default('Encaisser') }}
                </button>
            </div>
        </div>
    </div>
</div>

{{ form_row(form._token) }}
{{ form_end(form, {'render_rest': false}) }}

{# Prototype caché #}
<div id="ligne-vente-prototype-wrapper" class="d-none" data-prototype="{{ form_widget(form.ligneVentes.vars.prototype)|e('html_attr') }}"></div>

<script>
    // Configuration globale de TomSelect pour nos produits
    function initSelects(elements) {
        elements.forEach(function(el) {
            if (el.tomselect) return; // Déjà initialisé
            if (!el.classList.contains('produit-select')) return; // Juste au cas où

            new TomSelect(el, {
                create: false,
                sortField: { field: "text", direction: "asc" },
                placeholder: "Tapez pour chercher un produit...",
                render: {
                    option: function(data, escape) {
                        const optionEl = el.querySelector('option[value="' + escape(data.value) + '"]');
                        if (!optionEl) return '<div>' + escape(data.text) + '</div>';

                        const stock = optionEl.getAttribute('data-stock') || '0';
                        const dosage = optionEl.getAttribute('data-dosage') || '';
                        
                        let stockBadgeClass = parseInt(stock) > 10 ? 'bg-success' : (parseInt(stock) > 0 ? 'bg-warning text-dark' : 'bg-danger');

                        return '<div class="option">' +
                               '<span class="stock-badge ' + stockBadgeClass + '">Stock: ' + escape(stock) + '</span>' +
                               '<div class="nom">' + escape(data.text.split('-')[0]) + '</div>' +
                               '<div class="details">Dosage: ' + escape(dosage) + '</div>' +
                               '</div>';
                    },
                    item: function(data, escape) {
                        const optionEl = el.querySelector('option[value="' + escape(data.value) + '"]');
                        if (!optionEl) return '<div>' + escape(data.text) + '</div>';
                        const stock = optionEl.getAttribute('data-stock') || '0';
                        return '<div title="En stock: '+escape(stock)+'">' + escape(data.text) + '</div>';
                    }
                },
                onChange: function(value) {
                    if(!value) {
                        document.getElementById('produit-identity-card').classList.add('d-none');
                        return;
                    }
                    // Mettre à jour la carte d'identité
                    const optionEl = el.querySelector('option[value="' + value + '"]');
                    if (optionEl) {
                        const nom = optionEl.text.split('-')[0];
                        const dosage = optionEl.getAttribute('data-dosage') || '--';
                        const famille = optionEl.getAttribute('data-famille') || 'Non définie';
                        const description = optionEl.getAttribute('data-description') || 'Aucune description fournie pour ce produit.';
                        const stock = optionEl.getAttribute('data-stock') || '0';

                        document.getElementById('id-card-nom').textContent = nom;
                        document.getElementById('id-card-dosage').textContent = dosage;
                        document.getElementById('id-card-famille').textContent = famille;
                        document.getElementById('id-card-description').textContent = description;
                        document.getElementById('id-card-stock').textContent = stock;
                        
                        document.getElementById('produit-identity-card').classList.remove('d-none');
                        
                        // Met en évidence si le stock est faible
                        const stockEl = document.getElementById('id-card-stock');
                        if(parseInt(stock) < 5) {
                            stockEl.className = "text-danger fs-5 fw-bold";
                        } else {
                            stockEl.className = "text-success fs-5 fw-bold";
                        }
                    }
                }
            });
        });
    }

    function initVenteForm() {
        const addBtn = document.querySelector('.add-ligne-vente-btn');
        const list = document.querySelector('#ligne-ventes-list');
        const prototypeWrapper = document.querySelector('#ligne-vente-prototype-wrapper');

        // Initialiser les selects déjà présents
        initSelects(document.querySelectorAll('.produit-select'));

        if (!addBtn || !list || !prototypeWrapper) return;

        if (!list.dataset.index) {
            list.dataset.index = list.querySelectorAll('.ligne-vente-item').length;
        }

        const newBtn = addBtn.cloneNode(true);
        addBtn.parentNode.replaceChild(newBtn, addBtn);

        newBtn.addEventListener('click', function(e) {
            e.preventDefault();
            
            const prototype = prototypeWrapper.dataset.prototype;
            let index = parseInt(list.dataset.index);

            let newForm = prototype.replace(/__name__label__/g, index);
            newForm = newForm.replace(/__name__/g, index);

            const newItem = document.createElement('div');
            newItem.classList.add('ligne-vente-item', 'bg-white', 'p-3', 'mb-3', 'border', 'rounded', 'shadow-sm', 'position-relative');
            
            newItem.innerHTML = `
                <div class="row align-items-center">
                    <div class="col-md-5">${newForm.replace(/<div[^>]*>.*?<label[^>]*>.*?<\/label>.*?<select/s, '<select').replace(/<\/div>$/s, '')}</div>
                    <div class="col-md-1 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm border-0 remove-btn" title="Retirer"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
            `;
            newItem.innerHTML = `
                <div class="d-flex align-items-end gap-3 w-100">
                    <div class="flex-grow-1">${newForm}</div>
                    <button type="button" class="btn btn-outline-danger border-0 remove-btn mb-3" title="Retirer"><i class="bi bi-trash"></i></button>
                </div>
            `;

            list.appendChild(newItem);
            list.dataset.index = index + 1;

            // Initialiser TomSelect sur la nouvelle ligne ajoutée
            const newSelects = newItem.querySelectorAll('.produit-select');
            initSelects(newSelects);
        });

        list.addEventListener('click', function(e) {
            if (e.target && (e.target.matches('.remove-btn') || e.target.closest('.remove-btn'))) {
                e.preventDefault();
                const item = e.target.closest('.ligne-vente-item');
                // Détruire l'instance TomSelect si elle existe
                const select = item.querySelector('.produit-select');
                if (select && select.tomselect) {
                    select.tomselect.destroy();
                }
                item.remove();
                
                // Cacher la carte d'identité s'il n'y a plus de produit sélectionné
                document.getElementById('produit-identity-card').classList.add('d-none');
            }
        });
    }

    document.addEventListener('DOMContentLoaded', initVenteForm);
    document.addEventListener('turbo:load', initVenteForm);
</script>