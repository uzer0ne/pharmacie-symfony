                            </div>
                        </div>

                    </div>
                </div>

                <style>
                    @keyframes pos-pulse-ring { 0% { box-shadow: 0 0 0 0 rgba(var(--pulse-color), 0.7); } 70% { box-shadow: 0 0 0 8px rgba(var(--pulse-color), 0); } 100% { box-shadow: 0 0 0 0 rgba(var(--pulse-color), 0); } }
                    .pos-highlight-active { position: relative; z-index: 10; border: 2px solid rgb(var(--pulse-color)) !important; animation: pos-pulse-ring 1.5s infinite; }
                    .pos-highlight-active .pos-pin-icon { display: flex !important; }

                    /* THEMES */
