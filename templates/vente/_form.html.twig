<!-- Scripts et Styles TomSelect (CDN) -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<style>
/* Petits ajustements pour la carte d'identité du produit */
#produit-identity-card {
    transition: all 0.3s ease-in-out;
}
.ts-control {
    border-radius: 0.375rem;
}
.ts-dropdown .option {
    padding: 10px;
    border-bottom: 1px solid #f0f0f0;
}
.ts-dropdown .option .nom {
    font-weight: bold;
    color: #333;
}
.ts-dropdown .option .details {
    font-size: 0.85em;
    color: #666;
    margin-top: 4px;
}
.ts-dropdown .option .stock-badge {
    float: right;
    font-size: 0.8em;
    padding: 3px 6px;
    border-radius: 10px;
}

/* Alignement horizontal des champs ajoutés dynamiquement */
.dynamic-fields-wrapper > div {
    display: flex;
    gap: 15px;
    align-items: center;
    width: 100%;
}
.dynamic-fields-wrapper > div > div:nth-child(1) {
    flex: 3; /* Le produit prend plus de place */
    margin-bottom: 0 !important;
}
.dynamic-fields-wrapper > div > div:nth-child(2) {
    flex: 1; /* La quantité prend moins de place */
    margin-bottom: 0 !important;
}
</style>

{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row g-4">
    <!-- Section principale: POS & Scanner -->
    <div class="col-md-7 col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-cart text-primary me-2"></i> Produits du Panier
                </h5>
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-upc-scan text-muted"></i></span>
                    <input type="text" id="scanner-input" class="form-control border-start-0 bg-light" placeholder="Scanner CIP..." autocomplete="off">
                </div>
            </div>
            
            <div class="card-body p-4 bg-white">
                
                <!-- Zone d'ajout rapide (Le "vrai" formulaire vu par l'utilisateur) -->
                <div class="row align-items-end mb-4 p-3 bg-light rounded border border-2 border-primary border-opacity-25 shadow-sm">
                    <div class="col-md-8">
                        <label class="form-label fw-bold text-primary"><i class="bi bi-search me-1"></i> Rechercher un produit</label>
                        <select id="quick-add-produit" class="form-select produit-select-quick"></select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Quantité</label>
                        <input type="number" id="quick-add-qty" class="form-control fw-bold text-center" value="1" min="1">
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="quick-add-btn" class="btn btn-primary w-100 fw-bold">
                            <i class="bi bi-plus-lg"></i> Ajouter
                        </button>
                    </div>
                </div>

                <!-- Carte d'identité du produit (Affichée dynamiquement lors de la sélection) -->
                <div class="card border-0 shadow-sm d-none border-primary" id="produit-identity-card">
                    <div class="card-header bg-primary bg-opacity-10 text-primary border-bottom-0 pt-3 pb-2 px-4">
                        <h6 class="card-title mb-0 fw-bold">
                            <i class="bi bi-info-circle me-2"></i> Détails du produit sélectionné
                        </h6>
                    </div>
                    <div class="card-body p-4 bg-light rounded-bottom">
                        <h5 id="id-card-nom" class="fw-bold text-dark mb-1">Nom du produit</h5>
                        <p id="id-card-famille" class="text-muted small mb-3 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Famille</p>
                        
                        <div class="row mb-3 g-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded border border-2 text-center h-100 d-flex flex-column justify-content-center">
                                    <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size:0.75rem">Dosage</small>
                                    <strong id="id-card-dosage" class="text-dark fs-5">--</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded border border-2 text-center h-100 d-flex flex-column justify-content-center">
                                    <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size:0.75rem">En stock</small>
                                    <strong id="id-card-stock" class="text-primary fs-4">--</strong>
                                </div>
                            </div>
                        </div>

                        <p id="id-card-description" class="small text-secondary mb-0 border-top pt-3">
                            Description du produit...
                        </p>
                    </div>
                </div>

                <!-- FORMULAIRE SYMFONY CACHÉ (C'est ce qui sera envoyé au serveur) -->
                <div id="ligne-ventes-list" class="d-none collection-ligne-ventes" data-index="{{ form.ligneVentes|length }}">
                    {% for ligneVenteForm in form.ligneVentes %}
                        <div class="ligne-vente-item">
                            {{ form_row(ligneVenteForm.produit, {'attr': {'class': 'produit-select'}}) }}
                            {{ form_row(ligneVenteForm.quantite, {'attr': {'class': 'quantite-input'}}) }}
                        </div>
                    {% endfor %}
                </div>

            </div>
        </div>
    </div>

    <!-- Section latérale: Client & Résumé -->
    <div class="col-md-5 col-lg-4">
        <!-- Rendre la colonne collante pour ne pas la perdre de vue au scroll -->
        <div class="sticky-top" style="top: 1.5rem; z-index: 1020;">
            
            <!-- 1. RÉSUMÉ DE LA COMMANDE (Toujours visible en haut) -->
            <div class="card bg-primary text-white border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h6 class="text-white-50 text-uppercase fw-bold mb-3">Résumé de la commande</h6>
                    
                    <!-- Conteneur pour la liste dynamique des produits -->
                    <ul id="order-summary-list" class="list-unstyled mb-3 border-bottom border-light pb-3">
                        <li class="text-white-50 small fst-italic" id="empty-summary-msg">Aucun produit sélectionné</li>
                    </ul>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5">Montant Total</span>
                        <span class="fs-2 fw-bold text-white" id="total-amount-display">0,00 €</span>
                    </div>
                    
                    {{ form_errors(form) }}
                    {{ form_errors(form.ligneVentes) }}
                    
                    <button type="submit" class="btn btn-light w-100 py-3 fw-bold fs-5 text-primary">
                        <i class="bi bi-check-circle-fill me-2"></i> {{ button_label|default('Validé') }}
                    </button>
                </div>
            </div>

            <!-- 2. CLIENT & ORDONNANCE -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                    <h5 class="card-title mb-0 text-dark fw-bold">
                        <i class="bi bi-person text-primary me-2"></i> Client & Ordonnance
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        {{ form_label(form.patient, 'Sélectionner un patient', {'label_attr': {'class': 'fw-medium mb-2'}}) }}
                        {{ form_widget(form.patient, {'attr': {'class': 'form-select form-select-lg'}}) }}
                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Laissez vide pour une vente libre</small>
                    </div>
                    
                    <div class="mb-2">
                        <div class="form-check form-switch fs-6 mt-3 p-3 bg-light rounded border border-info border-opacity-25">
                            {{ form_widget(form.creer_ordonnance, {'attr': {'class': 'form-check-input ms-0 me-3'}}) }}
                            {{ form_label(form.creer_ordonnance, null, {'label_attr': {'class': 'form-check-label fw-bold text-dark'}}) }}
                            <div class="form-text mt-1 text-muted ms-5">
                                <i class="bi bi-info-circle me-1"></i>Créera automatiquement l'historique d'ordonnance pour ce patient.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

