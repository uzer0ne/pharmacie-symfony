{# Prototype caché #}
<div id="ligne-vente-prototype-wrapper" class="d-none" data-prototype="{{ form_widget(form.ligneVentes.vars.prototype)|e('html_attr') }}"></div>

<script>
    // === GESTION DE L'AFFICHAGE DU MEDECIN ===
    document.addEventListener('DOMContentLoaded', function() {
        const ordonnanceCheckbox = document.querySelector('input[type="checkbox"][id$="_creer_ordonnance"]');
        const medecinContainer = document.getElementById('medecin-container');
        const patientCol = document.getElementById('patient-col');
        
        if (ordonnanceCheckbox && medecinContainer && patientCol) {
            function toggleMedecin() {
                if (ordonnanceCheckbox.checked) {
                    medecinContainer.classList.remove('d-none');
                    medecinContainer.classList.add('col-md-6');
                    patientCol.classList.remove('col-12');
                    patientCol.classList.add('col-md-6');
                } else {
                    medecinContainer.classList.add('d-none');
                    medecinContainer.classList.remove('col-md-6');
                    patientCol.classList.remove('col-md-6');
                    patientCol.classList.add('col-12');
                }
            }
            ordonnanceCheckbox.addEventListener('change', toggleMedecin);
            toggleMedecin(); // Initial check
        }
    });

    // === MISE À JOUR DU RÉSUMÉ (PANIER UNIQUE) ===
    function updateOrderSummary() {
        const list = document.querySelector('#ligne-ventes-list');
        const summaryList = document.getElementById('order-summary-list');
        const totalDisplay = document.getElementById('total-amount-display');
        
        let total = 0;
        let summaryHtml = '';
        let hasItems = false;

        if (list) {
            list.querySelectorAll('.ligne-vente-item').forEach((item, index) => {
                const select = item.querySelector('select'); // Produit
                const qtyInput = item.querySelector('input'); // Quantité
                
                if (select && qtyInput && select.value) {
                    const option = select.querySelector(`option[value="${select.value}"]`);
                    if (option) {
                        const prix = parseFloat(option.getAttribute('data-prix') || 0);
                        const dosage = option.getAttribute('data-dosage') || '--';
                        const qty = parseInt(qtyInput.value || 1);
                        const nom = option.text.split('-')[0].trim();
                        
                        const subtotal = prix * qty;
                        total += subtotal;
                        hasItems = true;

                        // HTML de la carte du produit dans le résumé
                        summaryHtml += `
                            <li class="bg-white text-dark rounded p-3 mb-2 shadow-sm list-group-item-action">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="fw-bold text-primary" style="font-size:0.95rem">${nom}</div>
                                        <div class="text-muted" style="font-size:0.8rem">Dosage: <span class="fw-medium">${dosage}</span> | PU: ${prix.toFixed(2)} €</div>
                                    </div>
                                    <button type="button" class="btn btn-sm text-danger p-0 ms-2 cart-remove-btn" data-index="${index}"><i class="bi bi-x-circle-fill fs-5"></i></button>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                    <div class="input-group input-group-sm" style="width: 90px;">
                                        <button class="btn btn-outline-secondary px-2 cart-qty-minus" type="button" data-index="${index}">-</button>
                                        <input type="number" class="form-control text-center cart-qty-update fw-bold px-1" data-index="${index}" value="${qty}" min="1">
                                        <button class="btn btn-outline-secondary px-2 cart-qty-plus" type="button" data-index="${index}">+</button>
                                    </div>
                                    <div class="fw-bold fs-6">${subtotal.toFixed(2).replace('.', ',')} €</div>
                                </div>
                            </li>
                        `;
                    }
                }
            });
        }

        if (hasItems) {
            summaryList.innerHTML = summaryHtml;
        } else {
            summaryList.innerHTML = '<li class="text-white-50 small fst-italic py-2 text-center">Aucun produit dans le panier</li>';
        }

        totalDisplay.textContent = total.toFixed(2).replace('.', ',') + ' €';

        // Événements pour la quantité directe (input manuel)
        document.querySelectorAll('.cart-qty-update').forEach(input => {
            input.addEventListener('change', function() {
                const idx = this.getAttribute('data-index');
                const hiddenRows = list.querySelectorAll('.ligne-vente-item');
                if (hiddenRows[idx]) {
                    hiddenRows[idx].querySelector('input').value = Math.max(1, this.value);
                    updateOrderSummary();
                }
            });
        });

        // Événements pour les boutons + et -
        document.querySelectorAll('.cart-qty-minus').forEach(btn => {
            btn.addEventListener('click', function() {
                const idx = this.getAttribute('data-index');
                const hiddenRows = list.querySelectorAll('.ligne-vente-item');
                if (hiddenRows[idx]) {
                    const input = hiddenRows[idx].querySelector('input');
                    input.value = Math.max(1, parseInt(input.value) - 1);
                    updateOrderSummary();
                }
            });
        });
        document.querySelectorAll('.cart-qty-plus').forEach(btn => {
            btn.addEventListener('click', function() {
                const idx = this.getAttribute('data-index');
                const hiddenRows = list.querySelectorAll('.ligne-vente-item');
                if (hiddenRows[idx]) {
                    const input = hiddenRows[idx].querySelector('input');
                    input.value = parseInt(input.value) + 1;
                    updateOrderSummary();
                }
            });
        });

        // Événement pour la suppression
        document.querySelectorAll('.cart-remove-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const idx = this.getAttribute('data-index');
                const hiddenRows = list.querySelectorAll('.ligne-vente-item');
                if (hiddenRows[idx]) {
                    hiddenRows[idx].remove();
                    updateOrderSummary();
                }
            });
        });
    }

    // Configuration globale de TomSelect pour nos produits
    function initSelects(elements) {
        elements.forEach(function(el) {
            if (el.tomselect) return; 

            new TomSelect(el, {
                create: false,
                sortField: { field: "text", direction: "asc" },
                placeholder: "Tapez pour chercher un produit...",
                dropdownParent: 'body', // <-- FIX: Attache au body pour éviter les problèmes de z-index
                render: {
                    option: function(data, escape) {
                        const optionEl = el.querySelector('option[value="' + escape(data.value) + '"]');
                        if (!optionEl) return '<div>' + escape(data.text) + '</div>';

                        const stock = optionEl.getAttribute('data-stock') || '0';
                        const dosage = optionEl.getAttribute('data-dosage') || '';
                        const prix = optionEl.getAttribute('data-prix') || '0';
                        const zone = optionEl.getAttribute('data-zone') || '';
                        const colonne = optionEl.getAttribute('data-colonne') || '';
                        const niveau = optionEl.getAttribute('data-niveau') || '';
                        const position = optionEl.getAttribute('data-position') || '';
                        
                        let stockBadgeClass = parseInt(stock) > 10 ? 'bg-success text-white' : (parseInt(stock) > 0 ? 'bg-warning text-dark' : 'bg-danger text-white');
                        
                        let locationBadge = '';
                        if (zone) {
                            let locText = zone;
                            if ((zone === 'RX' || zone === 'OTC') && colonne) locText = `${zone}-${colonne}${niveau ? '-' + niveau : ''}${position ? '-' + position : ''}`;
                            else if (zone === 'FRIDGE') locText = 'Frigo';
                            else if (zone === 'SAFE') locText = 'Coffre';
                            else if (zone === 'PARA' || zone === 'STOCK' || zone === 'MAT') locText = 'Étagère';
                            
                            let locColor = 'bg-secondary';
                            if (zone === 'FRIDGE') locColor = 'bg-info text-dark';
                            else if (zone === 'SAFE') locColor = 'bg-danger';
                            else if (zone === 'RX' || zone === 'OTC') locColor = 'bg-primary';
                            else if (zone === 'PARA' || zone === 'STOCK' || zone === 'MAT') locColor = 'bg-success';
                            
                            locationBadge = `<span class="badge ${locColor} ms-2"><i class="bi bi-geo-alt-fill"></i> ${locText}</span>`;
                        }

                        return '<div class="option d-flex justify-content-between align-items-center w-100">' +
                               '<div>' +
                                 '<div class="nom">' + escape(data.text.split('-')[0]) + locationBadge + '</div>' +
                                 '<div class="details">Dosage: ' + escape(dosage) + ' | Prix: ' + parseFloat(prix).toFixed(2) + ' €</div>' +
                               '</div>' +
                               '<span class="stock-badge ' + stockBadgeClass + '">Stock: ' + escape(stock) + '</span>' +
                               '</div>';
                    },
                    item: function(data, escape) {
                        const optionEl = el.querySelector('option[value="' + escape(data.value) + '"]');
                        if (!optionEl) return '<div>' + escape(data.text) + '</div>';
                        const stock = optionEl.getAttribute('data-stock') || '0';
                        return '<div title="En stock: '+escape(stock)+'">' + escape(data.text) + '</div>';
                    }
                },
                onChange: function(value) {
                    if(!value) {
                        document.getElementById('produit-identity-card').classList.add('d-none');
                        return;
                    }
                    // Mettre à jour la carte d'identité
                    const optionEl = el.querySelector('option[value="' + value + '"]');
                    if (optionEl) {
                        const nom = optionEl.text.split('-')[0];
                        const dosage = optionEl.getAttribute('data-dosage') || '--';
                        const famille = optionEl.getAttribute('data-famille') || 'Non définie';
                        const description = optionEl.getAttribute('data-description') || 'Aucune description fournie pour ce produit.';
                        const stock = optionEl.getAttribute('data-stock') || '0';
                        const zone = optionEl.getAttribute('data-zone') || '';
                        const colonne = optionEl.getAttribute('data-colonne') || '';
                        const niveau = optionEl.getAttribute('data-niveau') || '';
                        const position = optionEl.getAttribute('data-position') || '';

                        document.getElementById('id-card-nom').textContent = nom;
                        document.getElementById('id-card-famille').textContent = famille;
                        
                        let locText = 'Emplacement non défini';
                        if (zone === 'FRIDGE') locText = 'Réfrigérateur';
                        else if (zone === 'SAFE') locText = 'Coffre-fort';
                        else if (zone === 'PARA' || zone === 'STOCK' || zone === 'MAT') locText = 'Étagères';
                        else if ((zone === 'RX' || zone === 'OTC') && colonne) {
                            locText = `${zone}-${colonne}${niveau ? '-' + niveau : ''}${position ? '-' + position : ''}`;
                        } else if (zone) {
                            locText = zone;
                        }
                        
                        document.getElementById('id-card-location-text').textContent = locText;
                        
                        document.getElementById('id-card-dosage').textContent = dosage;
                        document.getElementById('id-card-description').textContent = description;
                        document.getElementById('id-card-stock').textContent = stock;
                        
                        document.getElementById('produit-identity-card').classList.remove('d-none');
                        
                        const stockEl = document.getElementById('id-card-stock');
                        if(parseInt(stock) < 5) stockEl.className = "text-danger fs-5 fw-bold";
                        else stockEl.className = "text-success fs-5 fw-bold";
                        
                        // ===== SMART LOCATOR LOGIC =====
                        // Clear previous highlights
                        document.querySelectorAll('.pos-highlight-active').forEach(el => {
                            el.classList.remove('pos-highlight-active');
                            el.style.setProperty('--pulse-color', '');
                        });
                        
                        // Clear previous themes
                        const gridContainer = document.getElementById('pos-locator-grid-container');
                        gridContainer.className = 'bg-white border rounded p-2 shadow-sm h-100';
                        
                        if (zone) {
                            document.getElementById('pos-locator-container').classList.remove('d-none');
                            document.getElementById('pos-zone-title').textContent = 'Zone ' + zone + (colonne ? ` - Baie ${colonne}` : '') + (niveau ? ` - Étagère ${niveau}` : '') + (position ? ` - Pos ${position}` : '');
                            
                            // Apply CSS theme to grid
                            gridContainer.classList.add('pos-theme-' + zone.toLowerCase());
                            
                            let pulseColor = '108, 117, 125';
                            let iconClass = 'bi-geo-fill';
                            let famLower = famille.toLowerCase();
                            
                            if (zone === 'FRIDGE') { pulseColor = '6, 182, 212'; iconClass = 'bi-snow'; }
                            else if (zone === 'SAFE') { pulseColor = '239, 68, 68'; iconClass = 'bi-safe'; }
                            else if (zone === 'PARA' || zone === 'STOCK' || zone === 'MAT') { pulseColor = '34, 197, 94'; iconClass = 'bi-shop'; }
                            else if (zone === 'RX' || zone === 'OTC') {
                                if (famLower.includes('antibio') || famLower.includes('analg')) pulseColor = '59, 130, 246';
                                else if (famLower.includes('cardio') || famLower.includes('diab')) pulseColor = '139, 92, 246';
                                else pulseColor = '13, 110, 253';
                                iconClass = (zone === 'RX') ? 'bi-prescription' : 'bi-bag-plus';
                            }
                            
                            document.getElementById('pos-zone-icon').className = 'me-2 ' + iconClass;
                            document.getElementById('pos-zone-icon').style.color = `rgb(${pulseColor})`;
                            
                            // Highlight the specific cell
                            if (colonne && niveau) {
                                let targetEl = document.getElementById(`pos-drawer-${colonne}-${niveau}`);
                                if (targetEl) {
                                    targetEl.style.setProperty('--pulse-color', pulseColor);
                                    targetEl.classList.add('pos-highlight-active');
                                }
                            }
                            
                            // Render FEFO Drawer (Multi-channel)
                            const fefoContainer = document.getElementById('pos-fefo-drawer');
                            
                            let expDateStr = optionEl.getAttribute('data-expiration');
                            let currentStock = parseInt(stock) || 0;
                            let shortName = nom.length > 9 ? nom.substring(0, 9) + '.' : nom;
                            let firstLetter = nom.charAt(0).toUpperCase();
                            
                            let formattedExp = '--/--/----';
                            let statusFront = 'success';
                            
                            if(expDateStr) {
                                let expDate = new Date(expDateStr);
                                let today = new Date();
                                let diffTime = expDate - today;
                                let diffMonths = Math.floor(diffTime / (1000 * 60 * 60 * 24 * 30));
                                let isPast = expDate < today;
                                
                                if (isPast || diffMonths < 1) statusFront = 'danger';
                                else if (diffMonths <= 6) statusFront = 'warning';
                                
                                formattedExp = expDate.toLocaleDateString('fr-FR');
                            }
                            
                            function createChannel(id, isActive, name, boxCount, expDateStr, lotStr, status, stockCount) {
                                let html = `<div class="channel-pos ${isActive ? 'channel-active-pos' : ''}">`;
                                html += `<div class="position-absolute top-0 start-0 w-100 text-center text-secondary opacity-50 fw-bold" style="font-size: 0.5rem; margin-top: 2px;">C${id}</div>`;
                                
                                // Boîtes au fond
                                for (let i = 0; i < boxCount - 1; i++) {
                                    html += `<div class="med-box-pos">${name}</div>`;
                                }
                                
                                // Boîte à l'avant
                                html += `<div class="front-box-pos ${isActive ? 'front-box-active-pos' : ''} box-${status}-pos" ${isActive ? `data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true" title="<div class='text-start'><strong>Péremption:</strong> <span class='text-${status}'>${expDateStr}</span><br><strong>En stock:</strong> ${stockCount}</div>"` : ''}>
                                    <div class="text-center">
                                        <div class="box-title fw-bold" style="font-size: 0.55rem; line-height: 1;">${name}</div>
                                        <div class="text-secondary" style="font-size: 0.5rem; margin-top: 2px;">Lot: ${lotStr}</div>
                                    </div>
                                    <div class="box-badge text-center fw-bold rounded mt-1" style="font-size: 0.55rem; padding: 2px 0;">
                                        ${expDateStr}
                                    </div>`;
                                    
                                if (isActive) {
                                    html += `<div class="pioche-indicator-pos pioche-${status}-pos">↓ PIOCHEZ ICI</div>`;
                                }
                                
                                html += `</div></div>`;
                                return html;
                            }
                            
                            let html = '<div id="drawer-overlay-pos" class="drawer-overlay-pos active"></div>';
                            
                            // Get real siblings from the same drawer (zone, colonne, niveau)
                            let siblingOptions = Array.from(el.querySelectorAll('option')).filter(opt => {
                                return opt.value && 
                                       opt.getAttribute('data-zone') === zone && 
                                       opt.getAttribute('data-colonne') === colonne && 
                                       opt.getAttribute('data-niveau') === niveau;
                            });
                            
                            // Sort alphabetically (like in a real drawer)
                            siblingOptions.sort((a, b) => a.text.localeCompare(b.text));
                            
                            // Limit to 5 channels max so UI doesn't break
                            let activeIndex = siblingOptions.findIndex(opt => opt.value === value);
                            if (siblingOptions.length > 5) {
                                let start = Math.max(0, activeIndex - 2);
                                let end = Math.min(siblingOptions.length, start + 5);
                                if (end - start < 5) {
                                    start = Math.max(0, end - 5);
                                }
                                siblingOptions = siblingOptions.slice(start, end);
                            }
                            
                            // Generate channels
                            siblingOptions.forEach((opt, idx) => {
                                let isOptActive = (opt.value === value);
                                let optNom = opt.text.split('-')[0].trim();
                                let optShortName = optNom.length > 9 ? optNom.substring(0, 9) + '.' : optNom;
                                let optStock = parseInt(opt.getAttribute('data-stock')) || 0;
                                let optExpStr = opt.getAttribute('data-expiration');
                                
                                let optStatus = 'success';
                                let optFormattedExp = '--/--/----';
                                
                                if(optExpStr) {
                                    let expDate = new Date(optExpStr);
                                    let today = new Date();
                                    let diffTime = expDate - today;
                                    let diffMonths = Math.floor(diffTime / (1000 * 60 * 60 * 24 * 30));
                                    
                                    if (expDate < today || diffMonths < 1) optStatus = 'danger';
                                    else if (diffMonths <= 6) optStatus = 'warning';
                                    
                                    optFormattedExp = expDate.toLocaleDateString('fr-FR');
                                }
                                
                                let boxCount = optStock > 10 ? 3 : (optStock > 0 ? 2 : 1);
                                let lotStr = isOptActive ? 'L-42' : '...';
                                
                                html += createChannel(idx + 1, isOptActive, optShortName, boxCount, optFormattedExp, lotStr, optStatus, optStock);
                            });
                            
                            fefoContainer.innerHTML = html;
                            
                            // Initialize Tooltips dynamically
                            if(typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                                let tooltips = [].slice.call(fefoContainer.querySelectorAll('[data-bs-toggle="tooltip"]'));
                                tooltips.forEach(function (element) {
                                    new bootstrap.Tooltip(element, { html: true, sanitize: false });
                                });
                            }
                        } else {
                            document.getElementById('pos-locator-container').classList.add('d-none');
                        }
                    }
                }
            });
        });
    }

    function initVenteForm() {
        const list = document.querySelector('#ligne-ventes-list');
        const prototypeWrapper = document.querySelector('#ligne-vente-prototype-wrapper');
        const quickAddSelect = document.getElementById('quick-add-produit');
        const quickAddQty = document.getElementById('quick-add-qty');
        const quickAddBtn = document.getElementById('quick-add-btn');

        if (!list || !prototypeWrapper || !quickAddSelect) return;

        // Extraire les options du prototype pour remplir le select de recherche rapide
        if (quickAddSelect.options.length === 0) {
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = prototypeWrapper.dataset.prototype;
            const selectProto = tempDiv.querySelector('select');
            if (selectProto) {
                quickAddSelect.innerHTML = selectProto.innerHTML;
            }
        }

        // Initialiser TomSelect sur le champ de recherche rapide
        initSelects([quickAddSelect]);
        updateOrderSummary();

        if (!list.dataset.index) {
            list.dataset.index = list.querySelectorAll('.ligne-vente-item').length;
        }

        // --- Logique d'ajout au panier ---
        quickAddBtn.addEventListener('click', function(e) {
            e.preventDefault();
            
            const productId = quickAddSelect.value;
            const qtyToAdd = parseInt(quickAddQty.value || 1);

            if (!productId) {
                alert("Veuillez sélectionner un produit.");
                return;
            }

            // Vérifier si le produit est déjà dans le panier caché
            let existingRow = null;
            list.querySelectorAll('.ligne-vente-item').forEach(item => {
                const select = item.querySelector('select');
                if (select && select.value === productId) {
                    existingRow = item;
                }
            });

            if (existingRow) {
                // Incrémenter la quantité existante
                const qtyInput = existingRow.querySelector('input');
                qtyInput.value = parseInt(qtyInput.value) + qtyToAdd;
            } else {
                // Créer une nouvelle ligne cachée à partir du prototype
                const prototype = prototypeWrapper.dataset.prototype;
                let index = parseInt(list.dataset.index);

                let newForm = prototype.replace(/__name__label__/g, index);
                newForm = newForm.replace(/__name__/g, index);

                const newItem = document.createElement('div');
                newItem.classList.add('ligne-vente-item');
                newItem.innerHTML = newForm;

                // Assigner la valeur du produit et la quantité
                const newSelect = newItem.querySelector('select');
                const newQtyInput = newItem.querySelector('input');
                
                newSelect.value = productId;
                newQtyInput.value = qtyToAdd;

                list.appendChild(newItem);
                list.dataset.index = index + 1;
            }

            // Mettre à jour l'affichage
            updateOrderSummary();

            // Réinitialiser le formulaire rapide
            quickAddSelect.tomselect.clear();
            quickAddQty.value = 1;
        });
    }

    document.addEventListener('DOMContentLoaded', initVenteForm);
    document.addEventListener('turbo:load', initVenteForm);
</script>