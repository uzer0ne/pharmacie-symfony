<!-- Scripts et Styles TomSelect (CDN) -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

<style>
/* Petits ajustements pour la carte d'identité du produit */
#produit-identity-card {
    transition: all 0.3s ease-in-out;
}
.ts-control {
    border-radius: 0.375rem;
}
.ts-dropdown .option {
    padding: 10px;
    border-bottom: 1px solid #f0f0f0;
}
.ts-dropdown .option .nom {
    font-weight: bold;
    color: #333;
}
.ts-dropdown .option .details {
    font-size: 0.85em;
    color: #666;
    margin-top: 4px;
}
.ts-dropdown .option .stock-badge {
    float: right;
    font-size: 0.8em;
    padding: 3px 6px;
    border-radius: 10px;
}

/* Alignement horizontal des champs ajoutés dynamiquement */
.dynamic-fields-wrapper > div {
    display: flex;
    gap: 15px;
    align-items: center;
    width: 100%;
}
.dynamic-fields-wrapper > div > div:nth-child(1) {
    flex: 3; /* Le produit prend plus de place */
    margin-bottom: 0 !important;
}
.dynamic-fields-wrapper > div > div:nth-child(2) {
    flex: 1; /* La quantité prend moins de place */
    margin-bottom: 0 !important;
}
</style>

{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row g-4">
    <!-- Section principale: POS & Scanner -->
    <div class="col-md-7 col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-cart text-primary me-2"></i> Produits du Panier
                </h5>
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-upc-scan text-muted"></i></span>
                    <input type="text" id="scanner-input" class="form-control border-start-0 bg-light" placeholder="Scanner CIP..." autocomplete="off">
                </div>
            </div>
            
            <div class="card-body p-4 bg-white">
                
                <!-- Zone d'ajout rapide (Le "vrai" formulaire vu par l'utilisateur) -->
                <div class="row align-items-end mb-4 p-3 bg-light rounded border border-2 border-primary border-opacity-25 shadow-sm">
                    <div class="col-md-8">
                        <label class="form-label fw-bold text-primary"><i class="bi bi-search me-1"></i> Rechercher un produit</label>
                        <select id="quick-add-produit" class="form-select produit-select-quick"></select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Quantité</label>
                        <input type="number" id="quick-add-qty" class="form-control fw-bold text-center" value="1" min="1">
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="quick-add-btn" class="btn btn-primary w-100 fw-bold">
                            <i class="bi bi-plus-lg"></i> Ajouter
                        </button>
                    </div>
                </div>

                <!-- Carte d'identité du produit (Affichée dynamiquement lors de la sélection) -->
                <div class="card border-0 shadow-sm d-none border-primary" id="produit-identity-card">
                    <div class="card-header bg-primary bg-opacity-10 text-primary border-bottom-0 pt-3 pb-2 px-4">
                        <h6 class="card-title mb-0 fw-bold">
                            <i class="bi bi-info-circle me-2"></i> Détails du produit sélectionné
                        </h6>
                    </div>
                    <div class="card-body p-4 bg-light rounded-bottom">
                        <h5 id="id-card-nom" class="fw-bold text-dark mb-1">Nom du produit</h5>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <p id="id-card-famille" class="text-muted small mb-0 text-uppercase fw-semibold" style="letter-spacing: 0.5px;">Famille</p>
                            <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-geo-alt-fill me-1"></i> <span id="id-card-location-text">Emplacement</span></span>
                        </div>
                        
                        <div class="row mb-3 g-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded border border-2 text-center h-100 d-flex flex-column justify-content-center">
                                    <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size:0.75rem">Dosage</small>
                                    <strong id="id-card-dosage" class="text-dark fs-5">--</strong>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-white rounded border border-2 text-center h-100 d-flex flex-column justify-content-center">
                                    <small class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size:0.75rem">En stock</small>
                                    <strong id="id-card-stock" class="text-primary fs-4">--</strong>
                                </div>
                            </div>
                        </div>

                        <p id="id-card-description" class="small text-secondary mb-3 border-top pt-3">
                            Description du produit...
                        </p>
                        
                        <!-- VISUAL LOCATOR -->
