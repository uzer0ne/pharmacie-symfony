{% extends 'base.html.twig' %}

{% block title %}Historique des Ventes - Jeffarma{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-receipt text-primary me-2"></i> Historique des Ventes
        </h1>
        <p class="page-subtitle mb-0">Historique de toutes les ventes enregistrées</p>
    </div>
    <div>
        <a href="{{ path('app_vente_new') }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-cart-plus me-1"></i> Nouvelle Vente (POS)
        </a>
    </div>
</div>

<!-- Tableau des ventes -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 border-0">N° Ticket</th>
                        <th class="border-0">Date</th>
                        <th class="border-0">Patient</th>
                        <th class="border-0 text-end">Montant Total</th>
                        <th class="border-0 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for vente in ventes %}
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-dark">#{{ vente.id }}</span>
                                {% if vente.statut == 'PAYEE' %}
                                    <span class="badge bg-success ms-2" style="font-size: 0.7em;">Payée</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark ms-2" style="font-size: 0.7em;">En attente</span>
                                {% endif %}
                            </td>
                            <td class="text-muted">{{ vente.dateVente ? vente.dateVente|date('d/m/Y H:i') : '' }}</td>
                            <td>
                                {% if vente.patient %}
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <span class="fw-medium">{{ vente.patient.prenomPatient }} {{ vente.patient.nomPatient }}</span>
                                    </div>
                                {% else %}
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">
                                        Vente libre
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end fw-bold text-success">{{ vente.montantTotal|number_format(2, ',', ' ') }} €</td>
                            <td class="text-center pe-4">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <li>
                                            <a class="dropdown-item py-2" href="{{ path('app_vente_show', {'id': vente.id}) }}">
                                                <i class="bi bi-eye text-primary me-2"></i> Voir le reçu
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" href="{{ path('app_vente_edit', {'id': vente.id}) }}">
                                                <i class="bi bi-pencil text-warning me-2"></i> Modifier
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-receipt display-4 d-block mb-3 opacity-25"></i>
                                Aucune vente trouvée.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="px-4 pb-3">
            {{ include('partials/_pagination.html.twig', { items: ventes }) }}
        </div>
    </div>
</div>
{% endblock %}