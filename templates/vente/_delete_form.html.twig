<form method="post" action="{{ path('app_vente_delete', {'id': vente.id}) }}" 
      class="d-inline-block"
      data-controller="modal-form"
      data-action="submit->modal-form#confirm"
      data-modal-form-title-value="Supprimer la Vente"
      data-modal-form-text-value="Êtes-vous absolument sûr de vouloir supprimer la Vente n°{{ vente.id }} ? Cette action est irréversible et remettra les produits en stock.">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vente.id) }}">
    <button class="btn btn-danger shadow-sm">
        <i class="bi bi-trash me-1"></i> Supprimer
    </button>
</form>