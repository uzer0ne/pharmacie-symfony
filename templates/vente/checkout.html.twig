{% extends 'base.html.twig' %}

{% block title %}Encaissement{% endblock %}

{% block body %}
<div class="container mt-2">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white text-center py-2">
                    <h4 class="mb-0">Encaissement</h4>
                </div>
                <div class="card-body p-3">
                    
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Total Vente :</span>
                        <span class="fw-bold small">{{ vente.montantTotal }} €</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Part Sécu (RO) :</span>
                        <span class="small">- {{ vente.montantSecu }} €</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted small">Part Mutuelle (RC) :</span>
                        <span class="small">- {{ vente.montantMutuelle }} €</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 text-dark">Reste à payer :</h5>
                        <h3 class="mb-0 text-danger fw-bold" id="reste-a-payer" data-reste="{{ vente.resteAPayer }}">{{ vente.resteAPayer }} €</h3>
                    </div>

                    <form action="{{ path('app_vente_confirm_payment', {'id': vente.id}) }}" method="POST" id="form-encaissement">
                        <input type="hidden" name="_token" value="{{ csrf_token('confirm_payment' ~ vente.id) }}">

                        {# ── Mode de paiement ────────────────────────────────── #}
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small mb-1">Mode de paiement</label>
                            <div class="d-flex flex-wrap gap-2" id="mode-paiement-group">
                                <label class="btn btn-outline-success flex-fill text-center mode-btn active-mode py-1" data-mode="ESPECES">
                                    <input type="radio" name="mode_paiement" value="ESPECES" checked class="d-none">
                                    <i class="bi bi-cash d-block fs-5 mb-0"></i>
                                    <span class="small fw-bold" style="font-size: 0.8rem;">Espèces</span>
                                </label>
                                <label class="btn btn-outline-primary flex-fill text-center mode-btn py-1" data-mode="CB">
                                    <input type="radio" name="mode_paiement" value="CB" class="d-none">
                                    <i class="bi bi-credit-card d-block fs-5 mb-0"></i>
                                    <span class="small fw-bold" style="font-size: 0.8rem;">Carte</span>
                                </label>
                                <label class="btn btn-outline-warning flex-fill text-center mode-btn py-1" data-mode="CHEQUE">
                                    <input type="radio" name="mode_paiement" value="CHEQUE" class="d-none">
                                    <i class="bi bi-pen d-block fs-5 mb-0"></i>
                                    <span class="small fw-bold" style="font-size: 0.8rem;">Chèque</span>
                                </label>
                                <label class="btn btn-outline-info flex-fill text-center mode-btn py-1" data-mode="MUTUELLE">
                                    <input type="radio" name="mode_paiement" value="MUTUELLE" class="d-none">
                                    <i class="bi bi-shield-plus d-block fs-5 mb-0"></i>
                                    <span class="small fw-bold" style="font-size: 0.8rem;">Autres</span>
                                </label>
                            </div>
                        </div>
                        
                        {# ── Montant remis (visible uniquement si paiement espèces) ── #}
                        <div id="bloc-especes">
                            <div class="mb-2">
                                <label for="montant_encaisse" class="form-label text-success fw-bold small mb-1">Montant remis par le client (€)</label>
                                <input type="number" step="0.01" min="{{ vente.resteAPayer }}" class="form-control text-center fw-bold text-success" id="montant_encaisse" name="montant_encaisse" placeholder="0.00" style="font-size: 1.5rem; height: auto; padding: 0.25rem;">
                            </div>
                            <div class="alert alert-secondary text-center mb-3 py-2">
                                <span class="d-block text-muted small mb-0">Monnaie à rendre :</span>
                                <span class="fs-2 fw-bold text-primary" id="affichage_monnaie">0.00 €</span>
                                <input type="hidden" name="monnaie_rendue" id="monnaie_rendue" value="0.00">
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg py-2 fw-bold" style="font-size: 1.1rem;">
                                <i class="bi bi-check-circle me-1"></i> VALIDER
                            </button>
                            <a href="{{ path('app_vente_edit', {'id': vente.id}) }}" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-arrow-left me-1"></i> Modifier la vente
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const resteAPayer    = parseFloat(document.getElementById('reste-a-payer').dataset.reste);
    const inputEncaisse  = document.getElementById('montant_encaisse');
    const affichageMonnaie = document.getElementById('affichage_monnaie');
    const inputMonnaieRendue = document.getElementById('monnaie_rendue');
    const blocEspeces    = document.getElementById('bloc-especes');
    const form           = document.getElementById('form-encaissement');
    const modeBtns       = document.querySelectorAll('.mode-btn');

    // ── Initialisation ─────────────────────────────────────────────────
    if (resteAPayer === 0) {
        inputEncaisse.value = '0.00';
    }

    // ── Gestion du mode de paiement ──────────────────────────────────
    modeBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            modeBtns.forEach(b => b.classList.remove('active', 'active-mode'));
            this.classList.add('active', 'active-mode');

            const mode = this.dataset.mode;
            const needsChange = (mode === 'ESPECES');

            // Afficher/masquer le bloc rendu-monnaie
            blocEspeces.style.display = needsChange ? 'block' : 'none';
            inputEncaisse.required = needsChange;

            if (!needsChange) {
                // Pour CB, Chèque, Mutuelle : on pré-remplit avec le montant exact
                inputEncaisse.value = resteAPayer.toFixed(2);
                inputMonnaieRendue.value = '0.00';
            }
        });
    });

    // ── Calcul rendu-monnaie (mode espèces) ──────────────────────────
    inputEncaisse.addEventListener('input', function() {
        let encaisse = parseFloat(this.value);
        if (isNaN(encaisse)) encaisse = 0;
        
        let monnaie = encaisse - resteAPayer;
        
        if (monnaie >= 0) {
            affichageMonnaie.textContent = monnaie.toFixed(2) + ' €';
            inputMonnaieRendue.value = monnaie.toFixed(2);
            affichageMonnaie.classList.remove('text-danger');
            affichageMonnaie.classList.add('text-primary');
        } else {
            affichageMonnaie.textContent = 'Montant insuffisant';
            inputMonnaieRendue.value = '0.00';
            affichageMonnaie.classList.remove('text-primary');
            affichageMonnaie.classList.add('text-danger');
        }
    });

    // ── Validation avant soumission ──────────────────────────────────
    form.addEventListener('submit', function(e) {
        const modeActif = document.querySelector('input[name="mode_paiement"]:checked').value;
        
        if (modeActif === 'ESPECES') {
            let encaisse = parseFloat(inputEncaisse.value);
            if (isNaN(encaisse) || encaisse < resteAPayer) {
                e.preventDefault();
                alert('Le montant encaissé doit être supérieur ou égal au reste à payer.');
                inputEncaisse.focus();
            }
        } else {
            // Pour les autres modes, forcer le montant = reste à payer
            inputEncaisse.value = resteAPayer.toFixed(2);
            inputMonnaieRendue.value = '0.00';
        }
    });

    // Auto-focus
    inputEncaisse.focus();
});
</script>
{% endblock %}

