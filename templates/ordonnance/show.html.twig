{% extends 'base.html.twig' %}

{% block title %}Détail Ordonnance #{{ ordonnance.id }} - PharmaGest{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-file-medical text-primary me-2"></i> Ordonnance n°{{ ordonnance.id }}
        </h1>
        <p class="page-subtitle mb-0">Détails de la prescription du {{ ordonnance.dateOrdonnance ? ordonnance.dateOrdonnance|date('d/m/Y') : 'N/A' }}</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_ordonnance_index') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour
        </a>
        <button onclick="window.print()" class="btn btn-light border shadow-sm text-dark">
            <i class="bi bi-printer me-1"></i> Imprimer
        </button>
        <a href="{{ path('app_ordonnance_edit', {'id': ordonnance.id}) }}" class="btn btn-warning shadow-sm">
            <i class="bi bi-pencil-square me-1"></i> Modifier
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Colonne Principale: Produits -->
    <div class="col-lg-8">
        
        <div class="card shadow-sm border-0 mb-4" id="prescription-print">
            <div class="card-header bg-white border-bottom py-4 px-5">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0 text-dark fw-bold"><i class="bi bi-file-medical-fill text-primary me-2"></i> Prescription</h4>
                        <p class="text-muted mb-0 small mt-1">N°{{ ordonnance.id }}</p>
                    </div>
                    <div class="text-end text-muted">
                        <p class="mb-0"><i class="bi bi-calendar3 me-1"></i> Fait le {{ ordonnance.dateOrdonnance ? ordonnance.dateOrdonnance|date('d/m/Y') : 'N/A' }}</p>
                        <p class="mb-0 mt-1"><i class="bi bi-clock me-1"></i> Durée: {{ ordonnance.dureeTraitement }}</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-5">
                <h5 class="text-dark fw-bold mb-4 border-bottom pb-2">Produits prescrits</h5>
                <div class="table-responsive">
                    <table class="table table-borderless align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 border-0 rounded-start">Médicament</th>
                                <th class="border-0">Code CIP</th>
                                <th class="border-0 text-end rounded-end pe-3">Dosage</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for produit in ordonnance.produits %}
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-bold text-dark">{{ produit.nomProduit }}</div>
                                    </td>
                                    <td>
                                        <small class="text-muted font-monospace">{{ produit.codeProduit }}</small>
                                    </td>
                                    <td class="text-end pe-3">
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">{{ produit.dosageProduit }}</span>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        <i class="bi bi-capsule d-block fs-3 mb-2 opacity-50"></i>
                                        Aucun produit n'est rattaché à cette ordonnance.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="text-center text-muted mt-5 pt-4 border-top d-print-block d-none">
                    <p class="small mb-0">Original à conserver.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Colonne Latérale: Relations -->
    <div class="col-lg-4 d-print-none">
        
        <!-- Carte Patient -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-person text-info me-2"></i> Patient
                </h5>
            </div>
            <div class="card-body p-4">
                {% if ordonnance.patient %}
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <span class="fw-bold">{{ ordonnance.patient.prenomPatient|first|upper }}{{ ordonnance.patient.nomPatient|first|upper }}</span>
                        </div>
                        <div>
                            <div class="fw-bold fs-5 text-dark">{{ ordonnance.patient.prenomPatient }} {{ ordonnance.patient.nomPatient }}</div>
                            <small class="text-muted">ID: #{{ ordonnance.patient.idPatient }}</small>
                        </div>
                    </div>
                    <div class="text-muted small mb-3">
                        <i class="bi bi-geo-alt me-1"></i>{{ ordonnance.patient.adressePatient }}
                    </div>
                    <div class="d-grid">
                        <a href="{{ path('app_patient_show', {'idPatient': ordonnance.patient.idPatient}) }}" class="btn btn-outline-info btn-sm">
                            <i class="bi bi-person-lines-fill me-1"></i> Dossier patient
                        </a>
                    </div>
                {% else %}
                    <div class="text-center py-3">
                        <i class="bi bi-person-x display-4 text-muted opacity-25"></i>
                        <p class="text-muted mt-2">Aucun patient associé</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Carte Médecin -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-heart-pulse text-warning me-2"></i> Médecin
                </h5>
            </div>
            <div class="card-body p-4">
                {% if ordonnance.medecin %}
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-person-badge fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-5 text-dark">Dr. {{ ordonnance.medecin.prenomMedecin }} {{ ordonnance.medecin.nomMedecin }}</div>
                        </div>
                    </div>
                    <div class="text-muted small mb-1">
                        <i class="bi bi-telephone me-1"></i>{{ ordonnance.medecin.contactMedecin ?: 'Non renseigné' }}
                    </div>
                    <div class="text-muted small mb-3">
                        <i class="bi bi-geo-alt me-1"></i>{{ ordonnance.medecin.adresseMedecin ?: 'Non renseignée' }}
                    </div>
                    <div class="d-grid">
                        <a href="{{ path('app_medecin_show', {'idMedecin': ordonnance.medecin.id}) }}" class="btn btn-outline-warning btn-sm">
                            <i class="bi bi-person-vcard me-1"></i> Fiche médecin
                        </a>
                    </div>
                {% else %}
                    <div class="text-center py-3">
                        <i class="bi bi-person-x display-4 text-muted opacity-25"></i>
                        <p class="text-muted mt-2">Aucun médecin associé</p>
                    </div>
                {% endif %}
            </div>
        </div>
        
        <!-- Zone danger -->
        <div class="card border-danger border-opacity-25 bg-danger bg-opacity-10 shadow-sm">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Zone dangereuse</span>
                    {{ include('ordonnance/_delete_form.html.twig') }}
                </div>
            </div>
        </div>

    </div>
</div>

<style>
@media print {
    body { background-color: white !important; }
    .card { box-shadow: none !important; border: 1px solid #dee2e6 !important; }
}
</style>
{% endblock %}