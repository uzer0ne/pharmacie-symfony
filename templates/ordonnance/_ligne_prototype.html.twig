<div class="card bg-light border-0 mb-3 item-card shadow-sm">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between mb-2">
            <span class="fw-bold text-muted small text-uppercase"><i class="bi bi-capsule me-1"></i> Nouveau Médicament</span>
            <button type="button" class="btn btn-sm btn-link text-danger p-0 remove-item-btn"><i class="bi bi-trash"></i></button>
        </div>
        <div class="row g-2">
            <div class="col-md-8">
                {{ form_row(form.produit, {'attr': {'class': 'form-select form-select-sm produit-select'}}) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.quantite, {'attr': {'class': 'form-control form-control-sm quantite-input'}}) }}
            </div>
            <div class="col-md-12">
                {{ form_row(form.posologie, {'attr': {'class': 'form-control form-control-sm'}}) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.dureeTraitement, {'attr': {'class': 'form-control form-control-sm'}}) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.renouvellementsAutorises, {'attr': {'class': 'form-control form-control-sm'}}) }}
            </div>
        </div>
    </div>
</div>
