{% extends 'base.html.twig' %}

{% block title %}Ordonnances - Jeffarma{% endblock %}

{% block body %}
<!-- En-tête de page -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 page-title">
            <i class="bi bi-file-medical text-primary me-2"></i> Gestion des Ordonnances
        </h1>
        <p class="page-subtitle mb-0">Consultez et gérez l'ensemble des prescriptions</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_patient_index') }}" class="btn btn-outline-info shadow-sm">
            <i class="bi bi-people me-1"></i> Patients
        </a>
        <a href="{{ path('app_ordonnance_new') }}" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Nouvelle Ordonnance
        </a>
    </div>
</div>

<!-- Tableau des ordonnances -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        {% if ordonnances|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 border-0">N° Ord.</th>
                        <th class="border-0">Date</th>
                        <th class="border-0">Patient</th>
                        <th class="border-0">Médecin</th>
                        <th class="border-0">Produits / Durée</th>
                        <th class="border-0 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for ordonnance in ordonnances %}
                    <tr>
                        <td class="ps-4 text-dark fw-bold">#{{ ordonnance.id }}</td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-calendar3 me-1"></i>{{ ordonnance.dateOrdonnance ? ordonnance.dateOrdonnance|date('d/m/Y') : 'N/A' }}
                            </span>
                        </td>
                        <td>
                            {% if ordonnance.patient %}
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-2" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span class="fw-medium text-dark">{{ ordonnance.patient.prenomPatient }} {{ ordonnance.patient.nomPatient }}</span>
                                </div>
                            {% else %}
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                    <i class="bi bi-exclamation-triangle me-1"></i> Non défini
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            {% if ordonnance.medecin %}
                                <div class="text-dark fw-medium">Dr. {{ ordonnance.medecin.prenomMedecin }} {{ ordonnance.medecin.nomMedecin }}</div>
                            {% else %}
                                <span class="text-muted fst-italic">Non spécifié</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="mb-1">
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">
                                    <i class="bi bi-clock me-1"></i>{{ ordonnance.dureeTraitement }}
                                </span>
                            </div>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                {% if ordonnance.produits|length > 0 %}
                                    {% for produit in ordonnance.produits|slice(0, 3) %}
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                            {{ produit.nomProduit }}
                                        </span>
                                    {% endfor %}
                                    {% if ordonnance.produits|length > 3 %}
                                        <span class="badge bg-light text-muted border">+{{ ordonnance.produits|length - 3 }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted small">Aucun produit</span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="text-center pe-4">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_ordonnance_show', {'id': ordonnance.id}) }}">
                                            <i class="bi bi-eye text-primary me-2"></i> Voir les détails
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="{{ path('app_ordonnance_edit', {'id': ordonnance.id}) }}">
                                            <i class="bi bi-pencil text-warning me-2"></i> Modifier
                                        </a>
                                    </li>
                                    {% if ordonnance.patient %}
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item py-2" href="{{ path('app_patient_show', {'idPatient': ordonnance.patient.idPatient}) }}">
                                                <i class="bi bi-person-lines-fill text-info me-2"></i> Dossier patient
                                            </a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        <div class="px-4 pb-3">
            {{ include('partials/_pagination.html.twig', { items: ordonnances }) }}
        </div>
        {% else %}
        {{ include('partials/_empty_state.html.twig', {
            icon: 'file-medical',
            title: 'Aucune ordonnance enregistrée',
            subtitle: 'Commencez par créer votre première prescription médicale.',
            action: { label: 'Créer une Ordonnance', path: 'app_ordonnance_new', icon: 'plus-lg' }
        }) }}
        {% endif %}
    </div>
</div>
{% endblock %}