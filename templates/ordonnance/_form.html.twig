{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<div class="row g-4">
    <!-- Colonne Principale -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-file-medical text-primary me-2"></i> Informations de l'Ordonnance
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.date_ordonnance, {'attr': {'class': 'form-control', 'placeholder': 'Date de prescription'}}) }}
                            {{ form_label(form.date_ordonnance, 'Date de prescription *') }}
                            {{ form_errors(form.date_ordonnance) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            {{ form_widget(form.duree_traitement, {'attr': {'class': 'form-control fw-bold text-dark', 'placeholder': 'Durée (ex: 7 jours)'}}) }}
                            {{ form_label(form.duree_traitement, 'Durée du traitement *') }}
                            {{ form_errors(form.duree_traitement) }}
                        </div>
                    </div>
                </div>

                <hr class="my-4">
                
                <h6 class="text-dark fw-bold mb-3"><i class="bi bi-capsule text-primary me-2"></i>Produits Prescrits</h6>
                <div class="mb-3">
                    {{ form_widget(form.produits, {'attr': {'class': 'form-select', 'size': 6}}) }}
                    <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Maintenez Ctrl (ou Cmd) pour sélectionner plusieurs produits.</div>
                    {{ form_errors(form.produits) }}
                </div>
            </div>
        </div>
    </div>

    <!-- Colonne Latérale -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom pt-4 pb-3 px-4">
                <h5 class="card-title mb-0 text-dark fw-bold">
                    <i class="bi bi-link-45deg text-primary me-2"></i> Relations
                </h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-4">
                    {{ form_label(form.patient, 'Patient *', {'label_attr': {'class': 'fw-medium mb-2 text-dark'}}) }}
                    {{ form_widget(form.patient, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.patient) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.medecin, 'Médecin prescripteur', {'label_attr': {'class': 'fw-medium mb-2 text-dark'}}) }}
                    {{ form_widget(form.medecin, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.medecin) }}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
    <a href="{{ path('app_ordonnance_index') }}" class="btn btn-light text-muted fw-bold px-4 py-2">
        Annuler
    </a>
    <button type="submit" class="btn btn-primary fw-bold px-5 py-2 shadow-sm">
        {{ button_label|default('Enregistrer l\'Ordonnance') }}
    </button>
</div>

{{ form_end(form) }}

<style>
/* Surcharge locale pour les floating labels avec validation Symfony */
.form-floating > .form-control:focus ~ label,
.form-floating > .form-control:not(:placeholder-shown) ~ label {
    color: var(--color-primary);
    transform: scale(.85) translateY(-.5rem) translateX(.15rem);
}
.form-floating > .form-control {
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
}
.form-floating > .form-control:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 0.25rem rgba(16, 185, 129, 0.15); /* Vert émeraude */
}
</style>