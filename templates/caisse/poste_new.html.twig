{% extends 'base.html.twig' %}
{% block title %}Nouveau poste de caisse{% endblock %}

{% block body %}
<div class="d-flex align-items-center mb-4">
    <a href="{{ path('app_caisse_index') }}" class="btn btn-light btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h1 class="h3 fw-bold text-dark mb-0">
        <i class="bi bi-plus-circle text-primary me-2"></i> Nouveau poste de caisse
    </h1>
</div>

{% for flash_type, flash_messages in app.flashes %}
    {% for msg in flash_messages %}
        <div class="alert alert-{{ flash_type }}">{{ msg }}</div>
    {% endfor %}
{% endfor %}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form method="POST">
                    <div class="mb-4">
                        <label for="nom_poste" class="form-label fw-bold">Nom du poste</label>
                        <input type="text" id="nom_poste" name="nom_poste"
                               class="form-control form-control-lg"
                               placeholder="ex: Caisse 1 — Accueil"
                               required autofocus>
                        <div class="form-text">Ce nom sera visible par les caissiers lors de l'ouverture.</div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_caisse_index') }}" class="btn btn-light flex-grow-1">Annuler</a>
                        <button type="submit" class="btn btn-primary flex-grow-1 fw-bold">
                            <i class="bi bi-plus-circle me-1"></i> Créer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
