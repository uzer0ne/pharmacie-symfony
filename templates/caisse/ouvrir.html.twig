{% extends 'base.html.twig' %}
{% block title %}Ouvrir la caisse — {{ poste.nomPoste }}{% endblock %}

{% block body %}
<div class="d-flex align-items-center mb-4">
    <a href="{{ path('app_caisse_index') }}" class="btn btn-light btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h1 class="h3 fw-bold text-dark mb-0">
            <i class="bi bi-unlock text-success me-2"></i> Ouvrir la caisse
        </h1>
        <p class="text-muted mb-0">Poste : <strong>{{ poste.nomPoste }}</strong></p>
    </div>
</div>

{% for flash_type, flash_messages in app.flashes %}
    {% for msg in flash_messages %}
        <div class="alert alert-{{ flash_type }}">{{ msg }}</div>
    {% endfor %}
{% endfor %}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white p-4 border-0">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-wallet2 me-2"></i> Fond de caisse initial
                </h5>
                <p class="small mb-0 opacity-75 mt-1">
                    Comptez les espèces dans le tiroir avant de commencer la journée.
                </p>
            </div>
            <div class="card-body p-4">
                <form method="POST" action="{{ path('app_caisse_ouvrir', {id: poste.id}) }}">
                    <div class="mb-4">
                        <label for="fond_de_caisse" class="form-label fw-bold">
                            Montant du fond de caisse (€)
                        </label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">€</span>
                            <input
                                type="number"
                                id="fond_de_caisse"
                                name="fond_de_caisse"
                                class="form-control"
                                step="0.01"
                                min="0"
                                value="150.00"
                                required
                                autofocus
                            >
                        </div>
                        <div class="form-text text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Ce montant sera utilisé pour calculer l'écart en fin de journée (Ticket Z).
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="{{ path('app_caisse_index') }}" class="btn btn-light flex-grow-1">
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-success flex-grow-1 fw-bold">
                            <i class="bi bi-unlock me-1"></i> Ouvrir la caisse
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-4 bg-light">
            <div class="card-body p-3 small text-muted">
                <i class="bi bi-shield-check text-success me-1"></i>
                <strong>Traçabilité :</strong>
                L'ouverture sera enregistrée sous votre identifiant
                <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong>
                à {{ 'now'|date('H:i') }}.
            </div>
        </div>
    </div>
</div>
{% endblock %}
